<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rules as backup_rules.xml, for both the cloud backup and a transfer to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.companyname.financeapp.microsoft.maui.essentials.preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.companyname.financeapp.microsoft.maui.essentials.preferences.xml" />
    </device-transfer>
</data-extraction-rules>
