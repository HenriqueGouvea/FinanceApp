<Shell
    x:Class="FinanceApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinanceApp"
    xmlns:views="clr-namespace:FinanceApp.Views"
    xmlns:vm="clr-namespace:FinanceApp.ViewModels"
    xmlns:models="clr-namespace:FinanceApp.Models"
    xmlns:converters="clr-namespace:FinanceApp.Converters"
    Title="Mensal"
    FlyoutBehavior="Flyout">

    <!-- Greeting with the name and photo from the setup wizard, on the plum of the app's header -->
    <Shell.FlyoutHeader>
        <Grid x:Name="ProfileHeader"
              x:DataType="vm:UserProfileViewModel"
              ColumnDefinitions="Auto, *"
              ColumnSpacing="14"
              Padding="20,28,20,20"
              BackgroundColor="{DynamicResource Primary}">
            <Border Grid.Column="0"
                    AutomationId="FlyoutAvatar"
                    WidthRequest="52"
                    HeightRequest="52"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    BackgroundColor="{DynamicResource Accent}">
                <Grid>
                    <Label AutomationId="FlyoutAvatarInitialLabel"
                           Text="{Binding Initial}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasPhoto, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                    <Image AutomationId="FlyoutAvatarImage"
                           Source="{Binding PhotoPath}"
                           Aspect="AspectFill"
                           IsVisible="{Binding HasPhoto}" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label AutomationId="FlyoutGreetingLabel"
                       Text="{Binding Greeting}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="TailTruncation" />
                <Label Text="Todas as contas, um só rumo."
                       FontSize="12"
                       TextColor="{DynamicResource BillAccent}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Menu items: an icon and the title, the current page in lilac -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid ColumnDefinitions="36, *" ColumnSpacing="8" Padding="20,0" HeightRequest="52">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Secondary}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Image Source="{Binding FlyoutIcon}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="15"
                       FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource Ink}"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <ShellContent
        Title="Início"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage">
        <ShellContent.Icon>
            <FontImageSource Glyph="🏠" Size="20" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Categorias"
        ContentTemplate="{DataTemplate views:CategoriesPage}"
        Route="CategoriesPage">
        <ShellContent.Icon>
            <FontImageSource Glyph="🏷️" Size="20" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Contas e cartões"
        ContentTemplate="{DataTemplate views:PaymentSourcesPage}"
        Route="PaymentSourcesPage">
        <ShellContent.Icon>
            <FontImageSource Glyph="💳" Size="20" />
        </ShellContent.Icon>
    </ShellContent>

    <ShellContent
        Title="Configurações"
        ContentTemplate="{DataTemplate views:SettingsPage}"
        Route="SettingsPage">
        <ShellContent.Icon>
            <FontImageSource Glyph="⚙️" Size="20" />
        </ShellContent.Icon>
    </ShellContent>

    <!-- Current balance of each account and voucher, and the available limit of each credit card; tapping one opens it to update the balance -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout x:Name="BalancesFooter"
                             x:DataType="vm:PaymentSourceBalancesViewModel"
                             Padding="20,12,20,20"
                             Spacing="4">
            <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,0,0,8" />
            <Label AutomationId="FlyoutBalancesHeader"
                   Text="Saldo atual"
                   FontSize="12"
                   FontAttributes="Bold"
                   CharacterSpacing="0.6"
                   TextColor="{DynamicResource Muted}" />

            <Label AutomationId="FlyoutNoSourcesLabel"
                   Text="Toque para cadastrar suas contas e cartões"
                   FontSize="12"
                   TextColor="{DynamicResource Muted}"
                   Padding="0,6"
                   IsVisible="{Binding HasSources, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNoSourcesTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Scrolls once there are many sources, so the menu items stay visible -->
            <ScrollView MaximumHeightRequest="240" IsVisible="{Binding HasSources}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sources}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PaymentSourceSummary">
                            <Grid AutomationId="FlyoutSourceRow" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" Padding="0,8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSourceTapped" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="{DynamicResource Secondary}"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Source.Type, Converter={x:Static converters:PaymentSourceTypeToIconConverter.Instance}}"
                                           FontSize="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label AutomationId="FlyoutSourceNameLabel"
                                           Text="{Binding Source.Name}"
                                           FontSize="14"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource Ink}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Source.Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                                           FontSize="11"
                                           TextColor="{DynamicResource Muted}"
                                           IsVisible="{Binding IsCreditCard, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                                    <Label AutomationId="FlyoutSourceLimitLabel"
                                           Text="{Binding Source.Balance, Converter={x:Static converters:MoneyConverter.Instance}, StringFormat='Disponível de {0}'}"
                                           FontSize="11"
                                           TextColor="{DynamicResource Muted}"
                                           IsVisible="{Binding IsCreditCard}" />
                                </VerticalStackLayout>
                                <!-- Credit cards show the limit still available, in red once it is exceeded -->
                                <Label Grid.Column="2"
                                       AutomationId="FlyoutSourceBalanceLabel"
                                       Text="{Binding CurrentBalance, Converter={x:Static converters:MoneyConverter.Instance}}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Ink}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOverLimit}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Outcome}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
