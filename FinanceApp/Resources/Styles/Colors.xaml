<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand palette ("Mensal"): plum, lilac and amber, with green for incomes and red for outcomes -->
    <Color x:Key="Primary">#5B2A86</Color>
    <Color x:Key="PrimaryDark">#B48BDA</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#EFE6F8</Color>
    <Color x:Key="SecondaryDarkText">#B48BDA</Color>
    <Color x:Key="Tertiary">#3E1A60</Color>
    <Color x:Key="Accent">#F5A524</Color>
    <Color x:Key="AccentText">#24123A</Color>
    <Color x:Key="Income">#1F8F63</Color>
    <Color x:Key="Outcome">#C2414B</Color>

    <!-- Concept 1 ("Calendário") surfaces: lilac-white pages, white cards, ink text and soft lilac lines -->
    <Color x:Key="AppBackground">#F7F3FB</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="Ink">#24123A</Color>
    <Color x:Key="Muted">#7A6A8E</Color>
    <Color x:Key="Line">#EEE7F5</Color>
    <Color x:Key="LineStrong">#D7C9E6</Color>
    <!-- Month pill on the plum header: white at 16% -->
    <Color x:Key="HeaderPill">#29FFFFFF</Color>
    <Color x:Key="OutcomeTint">#FBEAEC</Color>
    <Color x:Key="OutcomeAlternateRow">#FDF5F6</Color>
    <Color x:Key="IncomeTint">#E5F5EE</Color>
    <Color x:Key="IncomeAlternateRow">#F3FBF7</Color>
    <Color x:Key="BillTint">#F3EAFB</Color>
    <Color x:Key="BillAccent">#B48BDA</Color>
    <!-- Paid is green for both types: a paid outcome is good news, so it never uses the outcome red -->
    <Color x:Key="Paid">#1F8F63</Color>
    <Color x:Key="Partial">#E8890C</Color>
    <Color x:Key="PaidProgressFill">#81C784</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrong}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="PartialBrush" Color="{StaticResource Partial}"/>
    <SolidColorBrush x:Key="OutcomeBrush" Color="{StaticResource Outcome}"/>
    <SolidColorBrush x:Key="IncomeBrush" Color="{StaticResource Income}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>