<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             x:Class="FinanceApp.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="Categorias">
    <Grid>
        <CollectionView ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        SelectionMode="None"
                        Margin="0,6,0,0">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma categoria cadastrada. Toque em + para criar."
                       TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center"
                       Margin="30" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:CategoryGroup">
                    <Label AutomationId="CategoryGroupHeader"
                           Text="{Binding Title}"
                           Style="{StaticResource GroupHeader}"
                           TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                           Padding="20,14,20,6" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FinancialCategory">
                    <!-- Each category is a white card; tapping it opens it for editing -->
                    <ContentView Padding="12,4">
                        <Border Style="{StaticResource Card}">
                            <Grid AutomationId="CategoryRow" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="14,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0"
                                        WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{Binding Color, Converter={x:Static converters:HexToColorConverter.Instance}}">
                                    <Label Text="{Binding Icon}" FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       AutomationId="CategoryNameLabel"
                                       Text="{Binding Name}"
                                       FontSize="15"
                                       FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2"
                                        AutomationId="DeleteCategoryButton"
                                        BackgroundColor="{StaticResource OutcomeTint}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,7"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDeleteCategoryClicked" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Excluir" TextColor="{StaticResource Outcome}" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <ContentView HeightRequest="96" />
            </CollectionView.Footer>
        </CollectionView>

        <Button AutomationId="AddCategoryButton"
                Style="{StaticResource FabButton}"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
