<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             x:Class="FinanceApp.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="Categorias">
    <Grid>
        <CollectionView ItemsSource="{Binding Categories}"
                        SelectionMode="None"
                        Margin="0,10,0,0">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma categoria cadastrada. Toque em + para criar."
                       TextColor="Gray"
                       HorizontalTextAlignment="Center"
                       Margin="30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FinancialCategory">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="20,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{Binding Color, Converter={x:Static converters:HexToColorConverter.Instance}}">
                            <Label Text="{Binding Icon}" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Border Grid.Column="2"
                                BackgroundColor="#D32F2F"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteCategoryClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Excluir" TextColor="White" FontSize="12" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="+"
                FontSize="24"
                BackgroundColor="Purple"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
