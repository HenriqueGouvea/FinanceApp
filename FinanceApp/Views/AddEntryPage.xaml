<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             xmlns:behaviors="clr-namespace:FinanceApp.Behaviors"
             x:Class="FinanceApp.Views.AddEntryPage"
             x:DataType="vm:AddEntryViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{StaticResource CardBackground}">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header: the back button is always at hand, so leaving doesn't require scrolling down to "Cancelar" -->
        <Grid Grid.Row="0" ColumnDefinitions="48, *, 48" Padding="4,6">
            <Button Grid.Column="0"
                    AutomationId="BackButton"
                    Text="←"
                    FontSize="24"
                    Padding="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Voltar"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   AutomationId="EntryPageTitleLabel"
                   Text="{Binding PageTitle}"
                   FontSize="17"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Line}" />

        <ScrollView Grid.Row="2">
        <VerticalStackLayout Spacing="14" Padding="20,14,20,24">
            <Entry x:Name="DescriptionEntry" AutomationId="DescriptionEntry" Placeholder="Descrição" Text="{Binding Description}" />

            <!-- Entry type: swipe or tap; disabled when editing (structural field) -->
            <Border AutomationId="EntryTypeToggle"
                    Style="{StaticResource SegmentedControl}"
                    IsEnabled="{Binding IsEditing, Converter={x:Static converters:InverseBoolConverter.Instance}}"
                    Opacity="{Binding StructuralFieldsOpacity}">
                <Border.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Right" Command="{Binding SelectIncomeCommand}" />
                    <SwipeGestureRecognizer Direction="Left"  Command="{Binding SelectOutcomeCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="3">
                    <!-- Despesa: filled in red while selected, tappable otherwise -->
                    <Border Grid.Column="0" Style="{StaticResource SegmentOption}" BackgroundColor="{StaticResource Outcome}"
                            IsVisible="{Binding IsIncome, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                        <Label Text="Despesa" Style="{StaticResource SegmentLabel}" TextColor="White" FontAttributes="Bold" />
                    </Border>
                    <Border Grid.Column="0" AutomationId="SelectOutcomeButton" Style="{StaticResource SegmentOption}"
                            IsVisible="{Binding IsIncome}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectOutcomeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Despesa" Style="{StaticResource SegmentLabel}" />
                    </Border>

                    <!-- Receita: filled in green while selected, tappable otherwise -->
                    <Border Grid.Column="1" Style="{StaticResource SegmentOption}" BackgroundColor="{StaticResource Income}"
                            IsVisible="{Binding IsIncome}">
                        <Label Text="Receita" Style="{StaticResource SegmentLabel}" TextColor="White" FontAttributes="Bold" />
                    </Border>
                    <Border Grid.Column="1" AutomationId="SelectIncomeButton" Style="{StaticResource SegmentOption}"
                            IsVisible="{Binding IsIncome, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectIncomeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Receita" Style="{StaticResource SegmentLabel}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Recurrence: disabled when editing (structural field) -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Recorrência" Style="{StaticResource FieldCaption}" />
                <Picker AutomationId="RecurrencePicker"
                        Title="Recorrência"
                        ItemsSource="{Binding RecurrenceTypes}"
                        ItemDisplayBinding="{Binding ., Converter={x:Static converters:RecurrenceTypeToLabelConverter.Instance}, x:DataType=models:RecurrenceType}"
                        SelectedItem="{Binding SelectedRecurrence}"
                        IsEnabled="{Binding IsEditing, Converter={x:Static converters:InverseBoolConverter.Instance}}"
                        Opacity="{Binding StructuralFieldsOpacity}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsInstallments}">
                <Label Text="Nº de parcelas" Style="{StaticResource FieldCaption}" />
                <Entry AutomationId="InstallmentsEntry"
                       Placeholder="Nº de parcelas"
                       Text="{Binding TotalInstallments}"
                       Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Annual (e.g. IPVA, IPTU): falls in this month every year, or in N consecutive months from it -->
            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsAnnual}">
                <Label Text="Parcelas no ano" Style="{StaticResource FieldCaption}" />
                <Entry AutomationId="AnnualInstallmentsEntry"
                       Placeholder="1 (pagamento único)"
                       Text="{Binding TotalInstallments}"
                       Keyboard="Numeric" />
                <Label AutomationId="AnnualHintLabel"
                       Text="Começa neste mês e se repete todo ano, como IPVA e IPTU. Com parcelas, elas caem nos meses seguintes (até 12)."
                       Style="{StaticResource Hint}" />
            </VerticalStackLayout>

            <!-- Amount: only shown once the recurrence defines what the amount means -->
            <VerticalStackLayout Spacing="0" IsVisible="{Binding HasRecurrence}">
                <Label Text="{Binding SelectedRecurrence, Converter={x:Static converters:RecurrenceTypeToAmountLabelConverter.Instance}}"
                       Style="{StaticResource FieldCaption}" />
                <Entry AutomationId="AmountEntry"
                       Placeholder="{Binding SelectedRecurrence, Converter={x:Static converters:RecurrenceTypeToAmountLabelConverter.Instance}}"
                       Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:CurrencyMaskBehavior Value="{Binding Amount}" />
                    </Entry.Behaviors>
                </Entry>
                <Label AutomationId="InstallmentsTotalLabel"
                       Text="{Binding InstallmentsTotal, Converter={x:Static converters:MoneyConverter.Instance}, StringFormat='Total: {0}'}"
                       Style="{StaticResource Hint}"
                       IsVisible="{Binding InstallmentsTotal, Converter={x:Static converters:IsNotNullConverter.Instance}}" />

                <!-- Estimated: the amount changes every month (e.g. energy bill, supermarket). A credit card purchase has a known amount, charged at once -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,12,0,0"
                      IsVisible="{Binding IsOnCreditCardBill, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Valor estimado" Style="{StaticResource RowTitle}" FontSize="14" />
                        <Label Text="Varia a cada mês, como luz ou mercado" Style="{StaticResource Hint}" FontSize="11" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            AutomationId="EstimatedSwitch"
                            IsToggled="{Binding IsEstimated}"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Partial payment: enables "Pagar parcial" for entries paid little by little (e.g. supermarket); a credit card purchase is paid with its bill -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0"
                      IsVisible="{Binding IsOnCreditCardBill, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label AutomationId="PartialPaymentSwitchLabel" Text="{Binding PartialPaymentLabel}" Style="{StaticResource RowTitle}" FontSize="14" />
                        <Label Text="{Binding PartialPaymentHint}" Style="{StaticResource Hint}" FontSize="11" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            AutomationId="PartialPaymentSwitch"
                            IsToggled="{Binding AllowsPartialPayment}"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Partial payment for the month the entry was opened from (e.g. supermarket spent so far) -->
            <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowsPaidAmount}">
                <Label AutomationId="PaidAmountLabel"
                       Text="{Binding PaidAmountLabel}"
                       Style="{StaticResource FieldCaption}" />
                <Entry AutomationId="PaidAmountEntry"
                       Placeholder="{Binding PaidAmountLabel}"
                       Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:CurrencyMaskBehavior Value="{Binding PaidAmount}" />
                    </Entry.Behaviors>
                </Entry>

                <!-- Partial payments recorded this month; a deleted one is only removed on save -->
                <VerticalStackLayout Spacing="0" Margin="0,10,0,0" IsVisible="{Binding HasPayments}">
                    <Label AutomationId="PaymentsHeaderLabel" Text="{Binding PaymentsHeader}" Style="{StaticResource FieldCaption}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Payments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaymentItem">
                                <Grid AutomationId="PaymentRow" ColumnDefinitions="Auto, *, Auto, 36" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           AutomationId="PaymentDateLabel"
                                           Text="{Binding Date, StringFormat='{0:dd/MM}'}"
                                           FontSize="13"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           AutomationId="PaymentDescriptionLabel"
                                           Text="{Binding Description}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding HasDescription}" />
                                    <Label Grid.Column="2"
                                           AutomationId="PaymentAmountLabel"
                                           Text="{Binding Amount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="3"
                                            AutomationId="DeletePaymentButton"
                                            Text="✕"
                                            FontSize="14"
                                            Padding="0"
                                            HeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Outcome}"
                                            Command="{Binding DeletePaymentCommand, Source={RelativeSource AncestorType={x:Type vm:AddEntryViewModel}}, x:DataType=vm:AddEntryViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Account, card or voucher the entry is paid with ("Pago com") or received in ("Recebido em"); it comes first since a credit card decides the due date; hidden while there are none to pick -->
            <VerticalStackLayout Spacing="0" IsVisible="{Binding HasPaymentSources}">
                <Label AutomationId="PaymentSourcePickerLabel" Text="{Binding PaymentSourceLabel}" Style="{StaticResource FieldCaption}" />
                <Picker AutomationId="PaymentSourcePicker"
                        Title="{Binding PaymentSourceLabel}"
                        ItemsSource="{Binding PaymentSources}"
                        ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                        SelectedItem="{Binding SelectedPaymentSource}" />
            </VerticalStackLayout>

            <!-- Due day, repeated every month for recurrent and installment entries; outcomes paid with a credit card fall due with its bill -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Vencimento" Style="{StaticResource FieldCaption}" />
                <Picker AutomationId="DueDayPicker"
                        Title="Vencimento"
                        ItemsSource="{Binding DueDays}"
                        ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                        SelectedItem="{Binding SelectedDueDay}"
                        IsVisible="{Binding IsOnCreditCardBill, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                <Label AutomationId="CreditCardBillDueHintLabel"
                       Text="{Binding CreditCardBillDueHint}"
                       FontSize="14"
                       TextColor="{StaticResource Muted}"
                       Padding="0,8"
                       IsVisible="{Binding IsOnCreditCardBill}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="0">
                <Label Text="Categoria" Style="{StaticResource FieldCaption}" />
                <Picker AutomationId="CategoryPicker"
                        Title="Categoria"
                        ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name, x:DataType=models:FinancialCategory}"
                        SelectedItem="{Binding SelectedCategory}" />
            </VerticalStackLayout>

            <!-- Tells upfront what choosing a credit card changes -->
            <Label AutomationId="CreditCardChoiceHintLabel"
                   Text="Com um cartão de crédito em “Pago com”, o vencimento passa a ser o da fatura e “Valor estimado” e “Pagamento parcial” somem."
                   Style="{StaticResource Hint}"
                   IsVisible="{Binding ShowsCreditCardChoiceHint}" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Grid.Column="0" AutomationId="CancelEntryButton" Text="Cancelar" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked" />
                <Button Grid.Column="1" AutomationId="SaveEntryButton" Text="Salvar" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
