<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             x:Class="FinanceApp.Views.OpenSourceNoticesPage"
             x:DataType="vm:AboutViewModel"
             Title="Licenças de código aberto">
    <ScrollView>
        <Border Style="{StaticResource Card}" Margin="12,14,12,24" Padding="16">
            <Label AutomationId="OpenSourceNoticesLabel" Text="{Binding Notices}" FontSize="12" TextColor="{StaticResource Ink}" />
        </Border>
    </ScrollView>
</ContentPage>
