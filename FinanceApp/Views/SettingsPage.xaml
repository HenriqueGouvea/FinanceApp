<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             x:Class="FinanceApp.Views.SettingsPage"
             x:DataType="vm:UserProfileViewModel"
             Title="Configurações">
    <ScrollView>
        <VerticalStackLayout Padding="12,6,12,24">

            <!-- Usuário -->
            <Label AutomationId="SettingsUserHeader" Text="Usuário" Style="{StaticResource GroupHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid AutomationId="SettingsProfileRow" ColumnDefinitions="Auto, *, Auto" Style="{StaticResource CardRow}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="Ellipse"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}">
                        <Grid>
                            <Label Text="{Binding Initial}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AccentText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasPhoto, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                            <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label AutomationId="SettingsProfileNameLabel" Text="{Binding DisplayName}" Style="{StaticResource RowTitle}" LineBreakMode="TailTruncation" />
                        <Label Text="Nome e foto, guardados só neste aparelho" Style="{StaticResource Hint}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Segurança -->
            <Label AutomationId="SettingsSecurityHeader" Text="Segurança" Style="{StaticResource GroupHeader}" Margin="0,8,0,0" />
            <Border Style="{StaticResource Card}">
                <Grid AutomationId="SettingsSecurityRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSecurityTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="PIN e biometria" Style="{StaticResource RowTitle}" />
                        <Label Text="Bloqueie o app com um PIN ou com a digital" Style="{StaticResource Hint}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Guia inicial -->
            <Label AutomationId="SettingsGuideHeader" Text="Guia inicial" Style="{StaticResource GroupHeader}" Margin="0,8,0,0" />
            <Border Style="{StaticResource Card}">
                <Grid AutomationId="SettingsRedoSetupRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRedoSetupTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Refazer configuração inicial" Style="{StaticResource RowTitle}" />
                        <Label Text="Cadastre contas, renda e gastos fixos de novo, sem apagar o que já existe" Style="{StaticResource Hint}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Seus dados: its BindingContext is a DataManagementViewModel, set in code-behind -->
            <Label AutomationId="SettingsDataHeader" Text="Seus dados" Style="{StaticResource GroupHeader}" Margin="0,8,0,0" />
            <Border x:Name="DataSection" Style="{StaticResource Card}" x:DataType="vm:DataManagementViewModel">
                <VerticalStackLayout>
                    <Grid AutomationId="SettingsExportRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Exportar dados" Style="{StaticResource RowTitle}" />
                            <Label Text="Um backup para levar a outro celular e uma planilha dos lançamentos (CSV)" Style="{StaticResource Hint}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="16,0" />
                    <Grid AutomationId="SettingsImportRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Importar backup" Style="{StaticResource RowTitle}" />
                            <Label Text="Troque os dados deste aparelho pelos de um backup do Mensal" Style="{StaticResource Hint}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="16,0" />
                    <Grid AutomationId="SettingsDeleteAllRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAllCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Apagar todos os dados" Style="{StaticResource RowTitle}" TextColor="{StaticResource Outcome}" />
                            <Label Text="Lançamentos, contas e cartões, categorias, perfil e PIN" Style="{StaticResource Hint}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
