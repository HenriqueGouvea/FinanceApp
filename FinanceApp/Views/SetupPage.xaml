<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             xmlns:behaviors="clr-namespace:FinanceApp.Behaviors"
             x:Class="FinanceApp.Views.SetupPage"
             x:DataType="vm:SetupViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>
        <!-- An expense the user can tick, with its amount, due day and the two kinds of varying bills -->
        <DataTemplate x:Key="SetupExpenseTemplate" x:DataType="vm:SetupExpenseItem">
            <Border AutomationId="SetupExpenseRow"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    StrokeThickness="2"
                    Padding="12,8">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="BackgroundColor" Value="{StaticResource BillTint}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <!-- Tapping the row (re)selects it; the check box only mirrors the state -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpenseCommand, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="SetupExpenseNameLabel" Text="{Binding Description}" FontSize="15" VerticalOptions="Center" />
                        <CheckBox Grid.Column="2"
                                  AutomationId="SetupExpenseCheckBox"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  InputTransparent="True"
                                  Color="{StaticResource Primary}"
                                  VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding IsSelected}">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Valor mensal" Style="{StaticResource FieldCaption}" />
                            <Entry AutomationId="SetupExpenseAmountEntry" Keyboard="Numeric">
                                <Entry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior Value="{Binding Amount}" />
                                </Entry.Behaviors>
                            </Entry>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Vencimento" Style="{StaticResource FieldCaption}" />
                            <Picker AutomationId="SetupExpenseDueDayPicker"
                                    Title="Vencimento"
                                    ItemsSource="{Binding DueDays, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                    ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                    SelectedItem="{Binding DueDay}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- The two kinds of varying bills, explained right where the user first meets them -->
                    <Grid AutomationId="SetupExpenseEstimatedOption"
                          ColumnDefinitions="Auto, *"
                          ColumnSpacing="6"
                          IsVisible="{Binding IsSelected}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleEstimatedCommand}" />
                        </Grid.GestureRecognizers>
                        <CheckBox Grid.Column="0"
                                  AutomationId="SetupExpenseEstimatedCheckBox"
                                  IsChecked="{Binding IsEstimated, Mode=OneWay}"
                                  InputTransparent="True"
                                  Color="{StaticResource Primary}"
                                  VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Valor estimado (±)" FontSize="14" />
                            <Label Text="O valor muda a cada mês, como luz e água. Você ajusta quando a conta chegar."
                                   FontSize="11"
                                   TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid AutomationId="SetupExpensePartialPaymentOption"
                          ColumnDefinitions="Auto, *"
                          ColumnSpacing="6"
                          IsVisible="{Binding IsSelected}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePartialPaymentCommand}" />
                        </Grid.GestureRecognizers>
                        <CheckBox Grid.Column="0"
                                  AutomationId="SetupExpensePartialPaymentCheckBox"
                                  IsChecked="{Binding AllowsPartialPayment, Mode=OneWay}"
                                  InputTransparent="True"
                                  Color="{StaticResource Primary}"
                                  VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Pagamento parcial" FontSize="14" />
                            <Label Text="Pago aos poucos durante o mês, como o mercado. Registre cada compra com &quot;Pagar parcial&quot;."
                                   FontSize="11"
                                   TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Header: the step and a way out, on every step -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,8,8,8">
            <Label Grid.Column="0"
                   AutomationId="SetupStepLabel"
                   FontSize="13"
                   TextColor="{StaticResource Muted}"
                   VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Passo " />
                        <Span Text="{Binding StepNumber}" />
                        <Span Text=" de " />
                        <Span Text="{Binding StepCount}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Grid.Column="1"
                    AutomationId="SetupSkipButton"
                    Text="{Binding SkipButtonText}"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Command="{Binding SkipCommand}" />
        </Grid>
        <ProgressBar Grid.Row="1"
                     AutomationId="SetupProgressBar"
                     Progress="{Binding Progress}"
                     ProgressColor="{StaticResource Primary}"
                     Margin="20,0" />

        <ScrollView x:Name="StepScroll" Grid.Row="2">
            <Grid Padding="20,20,20,24">

                <!-- 1. Welcome: name and photo -->
                <VerticalStackLayout AutomationId="SetupWelcomeStep" Spacing="16" IsVisible="{Binding IsWelcomeStep}">
                    <HorizontalStackLayout Spacing="14">
                        <Image Source="brand_logo.png" WidthRequest="56" HeightRequest="56" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label AutomationId="SetupWelcomeTitleLabel" Text="Bem-vindo ao Mensal!" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label AutomationId="SetupTaglineLabel" Text="Todas as contas, um só rumo." FontSize="15" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label FontSize="14"
                           TextColor="{StaticResource Ink}"
                           Text="Vamos montar o seu primeiro mês em poucos passos: suas contas e cartões, sua renda e os gastos fixos. Tudo pode ser alterado depois, e você pode pular o que quiser." />

                    <Grid WidthRequest="112" HeightRequest="112" HorizontalOptions="Center" Margin="0,8,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                        </Grid.GestureRecognizers>
                        <Border AutomationId="SetupAvatar"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Secondary}">
                            <Grid>
                                <Label AutomationId="SetupAvatarInitialLabel"
                                       Text="{Binding Initial}"
                                       FontSize="44"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding HasPhoto, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                                <Image AutomationId="SetupAvatarImage"
                                       Source="{Binding PhotoPath}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasPhoto}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Button AutomationId="SetupPickPhotoButton"
                                Text="Escolher foto"
                                FontSize="13"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="{StaticResource Primary}"
                                Command="{Binding PickPhotoCommand}" />
                        <Button AutomationId="SetupRemovePhotoButton"
                                Text="Remover foto"
                                FontSize="13"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Outcome}"
                                IsVisible="{Binding HasPhoto}"
                                Command="{Binding RemovePhotoCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="A foto é opcional e fica só neste aparelho." FontSize="11" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Seu nome" Style="{StaticResource FieldCaption}" />
                        <Entry AutomationId="SetupNameEntry" Placeholder="Como podemos te chamar?" Text="{Binding Name}" MaxLength="40" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 2. Accounts and vouchers -->
                <VerticalStackLayout AutomationId="SetupPaymentSourcesStep" Spacing="16" IsVisible="{Binding IsPaymentSourcesStep}">
                    <Label Text="Onde fica o seu dinheiro?" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label FontSize="14"
                           TextColor="{StaticResource Ink}"
                           Text="Cadastre suas contas bancárias e vales. Assim cada receita diz onde cai e cada despesa diz como é paga. Os cartões de crédito vêm no próximo passo." />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding NewSources}" Spacing="4" IsVisible="{Binding HasNewSources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PaymentSource">
                                <Grid AutomationId="SetupSourceRow" ColumnDefinitions="Auto, *, Auto, 36" ColumnSpacing="10" Padding="0,6">
                                    <Label Grid.Column="0"
                                           Text="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToIconConverter.Instance}}"
                                           FontSize="18"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label AutomationId="SetupSourceNameLabel" Text="{Binding Name}" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                                               FontSize="11"
                                               TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           AutomationId="SetupSourceBalanceLabel"
                                           Text="{Binding Balance, Converter={x:Static converters:MoneyConverter.Instance}}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="3"
                                            AutomationId="SetupRemoveSourceButton"
                                            Text="✕"
                                            FontSize="14"
                                            Padding="0"
                                            HeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Outcome}"
                                            Command="{Binding RemoveSourceCommand, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Entry AutomationId="SetupSourceNameEntry" Placeholder="Nome (ex.: Itaú)" Text="{Binding NewSourceName}" MaxLength="30" />

                            <Border Style="{StaticResource SegmentedControl}">
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="3">
                                    <Border Grid.Column="0"
                                            AutomationId="SetupSourceBankAccountTypeButton"
                                            Style="{StaticResource SegmentOption}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectSourceTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.BankAccount}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="🏦 Conta bancária" Style="{StaticResource SegmentLabel}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Border Grid.Column="1"
                                            AutomationId="SetupSourceMealVoucherTypeButton"
                                            Style="{StaticResource SegmentOption}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectSourceTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.MealVoucher}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="🍽️ Vale" Style="{StaticResource SegmentLabel}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="2">
                                <Label AutomationId="SetupSourceBalanceCaption"
                                       Text="{Binding NewSourceType, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                                       Style="{StaticResource FieldCaption}" />
                                <Entry AutomationId="SetupSourceBalanceEntry" Keyboard="Numeric">
                                    <Entry.Behaviors>
                                        <behaviors:CurrencyMaskBehavior Value="{Binding NewSourceBalance}" />
                                    </Entry.Behaviors>
                                </Entry>
                            </VerticalStackLayout>

                            <Button AutomationId="SetupAddSourceButton"
                                    Text="Adicionar"
                                    Command="{Binding AddSourceCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Credit cards and the purchases already on them -->
                <VerticalStackLayout AutomationId="SetupCreditCardsStep" Spacing="16" IsVisible="{Binding IsCreditCardsStep}">
                    <Label Text="Você usa cartão de crédito?" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label FontSize="14"
                           TextColor="{StaticResource Ink}"
                           Text="Cadastre seus cartões de crédito e as compras que já estão neles. Todo mês, as compras de um cartão de crédito são reunidas na fatura dele, que vence em um só dia." />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding NewCards}" Spacing="4" IsVisible="{Binding HasNewCards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupCreditCardItem">
                                <Grid AutomationId="SetupCardRow" ColumnDefinitions="Auto, *, Auto, 36" ColumnSpacing="10" Padding="0,6">
                                    <Label Grid.Column="0" Text="💳" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label AutomationId="SetupCardNameLabel" Text="{Binding Card.Name}" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label AutomationId="SetupCardDetailLabel" Text="{Binding Detail}" FontSize="11" TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           AutomationId="SetupCardLimitLabel"
                                           Text="{Binding Card.Balance, Converter={x:Static converters:MoneyConverter.Instance}}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="3"
                                            AutomationId="SetupRemoveCardButton"
                                            Text="✕"
                                            FontSize="14"
                                            Padding="0"
                                            HeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Outcome}"
                                            Command="{Binding RemoveCardCommand, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Entry AutomationId="SetupCardNameEntry" Placeholder="Nome (ex.: Nubank)" Text="{Binding NewCardName}" MaxLength="30" />

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Limite" Style="{StaticResource FieldCaption}" />
                                <Entry AutomationId="SetupCardLimitEntry" Keyboard="Numeric">
                                    <Entry.Behaviors>
                                        <behaviors:CurrencyMaskBehavior Value="{Binding NewCardLimit}" />
                                    </Entry.Behaviors>
                                </Entry>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Vencimento da fatura" Style="{StaticResource FieldCaption}" />
                                <Picker AutomationId="SetupCardBillDueDayPicker"
                                        Title="Vencimento da fatura"
                                        ItemsSource="{Binding DueDays}"
                                        ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                        SelectedItem="{Binding NewCardBillDueDay}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Fatura paga com" Style="{StaticResource FieldCaption}" />
                                <Picker AutomationId="SetupCardBillAccountPicker"
                                        Title="Fatura paga com"
                                        ItemsSource="{Binding BillAccounts}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                        SelectedItem="{Binding NewCardBillAccount}"
                                        IsVisible="{Binding HasBillAccounts}" />
                                <Label AutomationId="SetupNoBillAccountsLabel"
                                       Text="Volte ao passo anterior e cadastre uma conta bancária para escolher qual paga a fatura."
                                       FontSize="12"
                                       TextColor="{StaticResource Muted}"
                                       IsVisible="{Binding HasBillAccounts, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                            </VerticalStackLayout>

                            <Button AutomationId="SetupAddCardButton"
                                    Text="Adicionar cartão de crédito"
                                    Command="{Binding AddCardCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Purchases: only once there is a card to put them on -->
                    <VerticalStackLayout AutomationId="SetupPurchasesSection" Spacing="12" IsVisible="{Binding HasCreditCards}">
                        <Label Text="Compras no cartão de crédito" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label FontSize="13"
                               TextColor="{StaticResource Ink}"
                               Text="Inclua as parcelas que ainda faltam, as assinaturas (como streaming) e as compras deste mês. Elas entram na fatura do cartão de crédito." />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Purchases}" Spacing="4" IsVisible="{Binding HasPurchases}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SetupPurchaseItem">
                                    <Grid AutomationId="SetupPurchaseRow" ColumnDefinitions="*, Auto, 36" ColumnSpacing="10" Padding="0,6">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label AutomationId="SetupPurchaseDescriptionLabel" Text="{Binding Description}" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label AutomationId="SetupPurchaseDetailLabel" Text="{Binding Detail}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               AutomationId="SetupPurchaseAmountLabel"
                                               Text="{Binding Amount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Outcome}"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="2"
                                                AutomationId="SetupRemovePurchaseButton"
                                                Text="✕"
                                                FontSize="14"
                                                Padding="0"
                                                HeightRequest="36"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Outcome}"
                                                Command="{Binding RemovePurchaseCommand, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <VerticalStackLayout Spacing="12">
                                <Entry AutomationId="SetupPurchaseDescriptionEntry" Placeholder="Descrição (ex.: Celular novo)" Text="{Binding NewPurchaseDescription}" MaxLength="40" />

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Cartão de crédito" Style="{StaticResource FieldCaption}" />
                                    <Picker AutomationId="SetupPurchaseCardPicker"
                                            Title="Cartão de crédito"
                                            ItemsSource="{Binding CreditCards}"
                                            ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                            SelectedItem="{Binding NewPurchaseCard}" />
                                </VerticalStackLayout>

                                <Border Style="{StaticResource SegmentedControl}">
                                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="3">
                                        <Border Grid.Column="0"
                                                AutomationId="SetupPurchaseOneTimeButton"
                                                Style="{StaticResource SegmentOption}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding NewPurchaseRecurrence}" Value="{x:Static models:RecurrenceType.OneTime}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectPurchaseRecurrenceCommand}" CommandParameter="{x:Static models:RecurrenceType.OneTime}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="À vista" Style="{StaticResource SegmentLabel}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding NewPurchaseRecurrence}" Value="{x:Static models:RecurrenceType.OneTime}">
                                                        <Setter Property="TextColor" Value="White" />
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Grid.Column="1"
                                                AutomationId="SetupPurchaseInstallmentsButton"
                                                Style="{StaticResource SegmentOption}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding NewPurchaseRecurrence}" Value="{x:Static models:RecurrenceType.Installments}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectPurchaseRecurrenceCommand}" CommandParameter="{x:Static models:RecurrenceType.Installments}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Parcelada" Style="{StaticResource SegmentLabel}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding NewPurchaseRecurrence}" Value="{x:Static models:RecurrenceType.Installments}">
                                                        <Setter Property="TextColor" Value="White" />
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Grid.Column="2"
                                                AutomationId="SetupPurchaseRecurrentButton"
                                                Style="{StaticResource SegmentOption}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding NewPurchaseRecurrence}" Value="{x:Static models:RecurrenceType.Recurrent}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectPurchaseRecurrenceCommand}" CommandParameter="{x:Static models:RecurrenceType.Recurrent}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Todo mês" Style="{StaticResource SegmentLabel}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding NewPurchaseRecurrence}" Value="{x:Static models:RecurrenceType.Recurrent}">
                                                        <Setter Property="TextColor" Value="White" />
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- An installment purchase already in progress: "3 de 10" falls this month -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding IsNewPurchaseInstallments}">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Parcela deste mês" Style="{StaticResource FieldCaption}" />
                                        <Entry AutomationId="SetupPurchaseCurrentInstallmentEntry"
                                               Placeholder="ex.: 3"
                                               Text="{Binding NewPurchaseCurrentInstallment}"
                                               Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Nº de parcelas" Style="{StaticResource FieldCaption}" />
                                        <Entry AutomationId="SetupPurchaseTotalInstallmentsEntry"
                                               Placeholder="ex.: 10"
                                               Text="{Binding NewPurchaseTotalInstallments}"
                                               Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout Spacing="2">
                                    <Label AutomationId="SetupPurchaseAmountCaption"
                                           Text="{Binding NewPurchaseRecurrence, Converter={x:Static converters:RecurrenceTypeToAmountLabelConverter.Instance}}"
                                           Style="{StaticResource FieldCaption}" />
                                    <Entry AutomationId="SetupPurchaseAmountEntry" Keyboard="Numeric">
                                        <Entry.Behaviors>
                                            <behaviors:CurrencyMaskBehavior Value="{Binding NewPurchaseAmount}" />
                                        </Entry.Behaviors>
                                    </Entry>
                                </VerticalStackLayout>

                                <Button AutomationId="SetupAddPurchaseButton"
                                        Text="Adicionar compra"
                                        Command="{Binding AddPurchaseCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 4. Income -->
                <VerticalStackLayout AutomationId="SetupIncomeStep" Spacing="16" IsVisible="{Binding IsIncomeStep}">
                    <Label Text="Quanto você recebe por mês?" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label FontSize="14"
                           TextColor="{StaticResource Ink}"
                           Text="O salário vira uma receita recorrente (&quot;Todo mês&quot;): ela aparece em todos os meses, sem precisar lançar de novo." />

                    <!-- Common in Brazil: an advance ("vale") around the 20th and the rest on the 5th business day -->
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                <Label Text="Recebo o salário em duas partes" FontSize="15" />
                                <Label Text="Um adiantamento (vale) por volta do dia 20 e o restante (pagamento) até o 5º dia útil."
                                       FontSize="11"
                                       TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    AutomationId="SetupSalarySplitSwitch"
                                    IsToggled="{Binding IsSalarySplit}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label AutomationId="SetupSalaryCaption" Text="{Binding SalaryCaption}" Style="{StaticResource FieldCaption}" />
                            <Entry AutomationId="SetupSalaryEntry" Keyboard="Numeric">
                                <Entry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior Value="{Binding Salary}" />
                                </Entry.Behaviors>
                            </Entry>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Dia do pagamento" Style="{StaticResource FieldCaption}" />
                            <Picker AutomationId="SetupSalaryDayPicker"
                                    Title="Dia do pagamento"
                                    ItemsSource="{Binding DueDays}"
                                    ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                    SelectedItem="{Binding SalaryDay}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout AutomationId="SetupAdvanceFields" Spacing="12" IsVisible="{Binding IsSalarySplit}">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Adiantamento (vale)" Style="{StaticResource FieldCaption}" />
                                <Entry AutomationId="SetupAdvanceEntry" Keyboard="Numeric">
                                    <Entry.Behaviors>
                                        <behaviors:CurrencyMaskBehavior Value="{Binding Advance}" />
                                    </Entry.Behaviors>
                                </Entry>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Dia do adiantamento" Style="{StaticResource FieldCaption}" />
                                <Picker AutomationId="SetupAdvanceDayPicker"
                                        Title="Dia do adiantamento"
                                        ItemsSource="{Binding DueDays}"
                                        ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                        SelectedItem="{Binding AdvanceDay}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label FontSize="12"
                               TextColor="{StaticResource Muted}"
                               Text="O dia do pagamento é fixo: se ele cai no 5º dia útil, escolha o dia em que costuma cair." />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Total no mês" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   AutomationId="SetupMonthlySalaryLabel"
                                   Text="{Binding MonthlySalary, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Income}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAvailableSources}">
                        <Label Text="Recebido em" Style="{StaticResource FieldCaption}" />
                        <Picker AutomationId="SetupSalarySourcePicker"
                                Title="Recebido em"
                                ItemsSource="{Binding AvailableSources}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                SelectedItem="{Binding SalarySource}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 5. House expenses -->
                <VerticalStackLayout AutomationId="SetupHouseExpensesStep" Spacing="12" IsVisible="{Binding IsHouseExpensesStep}">
                    <Label Text="Quais são os gastos fixos da casa?" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label FontSize="14"
                           TextColor="{StaticResource Ink}"
                           Text="Marque os que você tem e informe o valor de um mês. Cada um vira uma despesa recorrente. Depois, diga se o valor muda todo mês ou se é pago aos poucos." />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses}"
                                         BindableLayout.ItemTemplate="{StaticResource SetupExpenseTemplate}"
                                         Spacing="8" />

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAvailableSources}">
                        <Label Text="Pago com" Style="{StaticResource FieldCaption}" />
                        <Picker AutomationId="SetupExpensesSourcePicker"
                                Title="Pago com"
                                ItemsSource="{Binding AvailableSources}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                SelectedItem="{Binding ExpensesSource}" />
                        <Label AutomationId="SetupExpensesCardHint"
                               Text="Pagas com cartão de crédito, elas entram na fatura: vencem com ela e não usam valor estimado nem pagamento parcial."
                               FontSize="12"
                               TextColor="{StaticResource Muted}"
                               IsVisible="{Binding IsExpensesSourceCreditCard}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 6. Other expenses: health, children's school and eating out -->
                <VerticalStackLayout AutomationId="SetupOtherExpensesStep" Spacing="12" IsVisible="{Binding IsOtherExpensesStep}">
                    <Label Text="E os outros gastos do mês?" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label FontSize="14"
                           TextColor="{StaticResource Ink}"
                           Text="Saúde, a escola dos filhos e o que você gasta comendo fora também viram despesas recorrentes." />

                    <Label Text="Saúde" Style="{StaticResource GroupHeader}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding HealthExpenses}"
                                         BindableLayout.ItemTemplate="{StaticResource SetupExpenseTemplate}"
                                         Spacing="8" />

                    <Label Text="Filhos" Style="{StaticResource GroupHeader}" />
                    <Label Text="Você tem filhos?" FontSize="15" />
                    <Border Style="{StaticResource SegmentedControl}">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="3">
                            <Border Grid.Column="0"
                                    AutomationId="SetupNoChildrenButton"
                                    Style="{StaticResource SegmentOption}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasChildren}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectHasChildrenCommand}">
                                        <TapGestureRecognizer.CommandParameter>
                                            <x:Boolean>False</x:Boolean>
                                        </TapGestureRecognizer.CommandParameter>
                                    </TapGestureRecognizer>
                                </Border.GestureRecognizers>
                                <Label Text="Não" Style="{StaticResource SegmentLabel}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasChildren}" Value="False">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Border Grid.Column="1"
                                    AutomationId="SetupHasChildrenButton"
                                    Style="{StaticResource SegmentOption}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasChildren}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectHasChildrenCommand}">
                                        <TapGestureRecognizer.CommandParameter>
                                            <x:Boolean>True</x:Boolean>
                                        </TapGestureRecognizer.CommandParameter>
                                    </TapGestureRecognizer>
                                </Border.GestureRecognizers>
                                <Label Text="Sim" Style="{StaticResource SegmentLabel}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasChildren}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>
                    <VerticalStackLayout AutomationId="SetupSchoolExpenses"
                                         BindableLayout.ItemsSource="{Binding SchoolExpenses}"
                                         BindableLayout.ItemTemplate="{StaticResource SetupExpenseTemplate}"
                                         Spacing="8"
                                         IsVisible="{Binding HasChildren}" />

                    <Label Text="Lazer" Style="{StaticResource GroupHeader}" />
                    <Label FontSize="12"
                           TextColor="{StaticResource Muted}"
                           Text="Comer fora e pedir comida ficam separados do mercado: são um prazer, não uma necessidade, e é aqui que costuma dar para economizar." />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LeisureExpenses}"
                                         BindableLayout.ItemTemplate="{StaticResource SetupExpenseTemplate}"
                                         Spacing="8" />

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAvailableSources}">
                        <Label Text="Pago com" Style="{StaticResource FieldCaption}" />
                        <Picker AutomationId="SetupOtherExpensesSourcePicker"
                                Title="Pago com"
                                ItemsSource="{Binding AvailableSources}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                SelectedItem="{Binding OtherExpensesSource}" />
                        <Label AutomationId="SetupOtherExpensesCardHint"
                               Text="Pagas com cartão de crédito, elas entram na fatura: vencem com ela e não usam valor estimado nem pagamento parcial."
                               FontSize="12"
                               TextColor="{StaticResource Muted}"
                               IsVisible="{Binding IsOtherExpensesSourceCreditCard}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 7. Summary, and how entries work -->
                <VerticalStackLayout AutomationId="SetupSummaryStep" Spacing="16" IsVisible="{Binding IsSummaryStep}">
                    <Label AutomationId="SetupSummaryTitleLabel" Text="{Binding SummaryTitle}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSummaryRows}">
                        <Label Text="Estes lançamentos serão criados a partir deste mês:" FontSize="14" TextColor="{StaticResource Ink}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SummaryRows}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SetupSummaryRow">
                                    <Grid AutomationId="SetupSummaryRow" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label AutomationId="SetupSummaryDescriptionLabel" Text="{Binding Description}" FontSize="15" />
                                            <Label AutomationId="SetupSummaryDetailLabel" Text="{Binding Detail}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="SetupSummaryAmountLabel"
                                               Text="{Binding Amount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                            <Label Grid.Row="0" Text="Receitas neste mês" FontSize="14" />
                            <Label Grid.Row="0" Grid.Column="1" AutomationId="SetupSummaryIncomeLabel"
                                   Text="{Binding TotalIncome, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14" TextColor="{StaticResource Income}" />
                            <Label Grid.Row="1" Text="Despesas neste mês" FontSize="14" />
                            <Label Grid.Row="1" Grid.Column="1" AutomationId="SetupSummaryOutcomeLabel"
                                   Text="{Binding TotalOutcome, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14" TextColor="{StaticResource Outcome}" />
                            <Label Grid.Row="2" Text="Sobra no mês" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="1" AutomationId="SetupSummaryBalanceLabel"
                                   Text="{Binding Balance, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>

                    <Label AutomationId="SetupSummaryEmptyLabel"
                           Text="Nenhum lançamento será criado agora. Você pode adicioná-los quando quiser pelo botão +."
                           FontSize="14"
                           TextColor="{StaticResource Ink}"
                           IsVisible="{Binding HasSummaryRows, Converter={x:Static converters:InverseBoolConverter.Instance}}" />

                    <Border AutomationId="SetupRecurrenceGuide"
                            BackgroundColor="{StaticResource Secondary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Como funcionam os lançamentos" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label FontSize="13" TextColor="{StaticResource Ink}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Única: " FontAttributes="Bold" />
                                        <Span Text="acontece uma vez, como uma compra à vista." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="{StaticResource Ink}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Todo mês (recorrente): " FontAttributes="Bold" />
                                        <Span Text="se repete todos os meses, sem data para acabar, como o salário e o aluguel." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="{StaticResource Ink}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Parcelada: " FontAttributes="Bold" />
                                        <Span Text="se repete por um número fixo de meses, como uma compra em 10x." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="{StaticResource Ink}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Fatura do cartão de crédito: " FontAttributes="Bold" />
                                        <Span Text="as compras de cada cartão de crédito ficam juntas na fatura dele e são pagas de uma vez com &quot;Pagar fatura&quot;." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="{StaticResource Ink}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Valor estimado (±): " FontAttributes="Bold" />
                                        <Span Text="para contas que mudam a cada mês. Ajuste o valor quando a conta chegar." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="{StaticResource Ink}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Pagamento parcial: " FontAttributes="Bold" />
                                        <Span Text="para gastos pagos aos poucos, como o mercado. Registre cada compra com &quot;Pagar parcial&quot;." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13"
                                   TextColor="{StaticResource Ink}"
                                   Text="Toque em um lançamento para editá-lo e segure-o para marcar como pago ou excluir." />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10" Padding="20,8,20,16">
            <Button Grid.Column="0"
                    AutomationId="SetupBackButton"
                    Text="Voltar"
                    Style="{StaticResource SecondaryButton}"
                    IsVisible="{Binding IsFirstStep, Converter={x:Static converters:InverseBoolConverter.Instance}}"
                    Command="{Binding BackCommand}" />
            <Button Grid.Column="1"
                    AutomationId="SetupNextButton"
                    Text="{Binding NextButtonText}"
                    Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</ContentPage>
