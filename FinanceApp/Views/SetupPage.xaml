<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             xmlns:behaviors="clr-namespace:FinanceApp.Behaviors"
             x:Class="FinanceApp.Views.SetupPage"
             x:DataType="vm:SetupViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Header: the step and a way out, on every step -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,8,8,8">
            <Label Grid.Column="0"
                   AutomationId="SetupStepLabel"
                   FontSize="13"
                   TextColor="Gray"
                   VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Passo " />
                        <Span Text="{Binding StepNumber}" />
                        <Span Text=" de " />
                        <Span Text="{Binding StepCount}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Grid.Column="1"
                    AutomationId="SetupSkipButton"
                    Text="{Binding SkipButtonText}"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="Purple"
                    Command="{Binding SkipCommand}" />
        </Grid>
        <ProgressBar Grid.Row="1"
                     AutomationId="SetupProgressBar"
                     Progress="{Binding Progress}"
                     ProgressColor="Purple"
                     Margin="20,0" />

        <ScrollView x:Name="StepScroll" Grid.Row="2">
            <Grid Padding="20,20,20,24">

                <!-- 1. Welcome: name and photo -->
                <VerticalStackLayout AutomationId="SetupWelcomeStep" Spacing="16" IsVisible="{Binding IsWelcomeStep}">
                    <Label Text="Bem-vindo ao FinanceApp!" FontSize="24" FontAttributes="Bold" TextColor="Purple" />
                    <Label FontSize="14"
                           TextColor="#424242"
                           Text="Vamos montar o seu primeiro mês em poucos passos: suas contas, sua renda e os gastos fixos da casa. Tudo pode ser alterado depois, e você pode pular o que quiser." />

                    <Grid WidthRequest="112" HeightRequest="112" HorizontalOptions="Center" Margin="0,8,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                        </Grid.GestureRecognizers>
                        <Border AutomationId="SetupAvatar"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                BackgroundColor="#EDE7F6">
                            <Grid>
                                <Label AutomationId="SetupAvatarInitialLabel"
                                       Text="{Binding Initial}"
                                       FontSize="44"
                                       TextColor="Purple"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding HasPhoto, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                                <Image AutomationId="SetupAvatarImage"
                                       Source="{Binding PhotoPath}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasPhoto}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Button AutomationId="SetupPickPhotoButton"
                                Text="Escolher foto"
                                FontSize="13"
                                BackgroundColor="#EDE7F6"
                                TextColor="Purple"
                                Command="{Binding PickPhotoCommand}" />
                        <Button AutomationId="SetupRemovePhotoButton"
                                Text="Remover foto"
                                FontSize="13"
                                BackgroundColor="Transparent"
                                TextColor="#D32F2F"
                                IsVisible="{Binding HasPhoto}"
                                Command="{Binding RemovePhotoCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="A foto é opcional e fica só neste aparelho." FontSize="11" TextColor="Gray" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Seu nome" FontSize="12" TextColor="Gray" />
                        <Entry AutomationId="SetupNameEntry" Placeholder="Como podemos te chamar?" Text="{Binding Name}" MaxLength="40" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 2. Accounts, cards and vouchers -->
                <VerticalStackLayout AutomationId="SetupPaymentSourcesStep" Spacing="16" IsVisible="{Binding IsPaymentSourcesStep}">
                    <Label Text="Onde fica o seu dinheiro?" FontSize="24" FontAttributes="Bold" TextColor="Purple" />
                    <Label FontSize="14"
                           TextColor="#424242"
                           Text="Cadastre suas contas, cartões de crédito e vales. Assim cada receita diz onde cai e cada despesa diz como é paga." />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding NewSources}" Spacing="4" IsVisible="{Binding HasNewSources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PaymentSource">
                                <Grid AutomationId="SetupSourceRow" ColumnDefinitions="Auto, *, Auto, 36" ColumnSpacing="10" Padding="0,6">
                                    <Label Grid.Column="0"
                                           Text="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToIconConverter.Instance}}"
                                           FontSize="18"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label AutomationId="SetupSourceNameLabel" Text="{Binding Name}" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                                               FontSize="11"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           AutomationId="SetupSourceBalanceLabel"
                                           Text="{Binding Balance, Converter={x:Static converters:MoneyConverter.Instance}}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="3"
                                            AutomationId="SetupRemoveSourceButton"
                                            Text="✕"
                                            FontSize="14"
                                            Padding="0"
                                            HeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="#D32F2F"
                                            Command="{Binding RemoveSourceCommand, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Entry AutomationId="SetupSourceNameEntry" Placeholder="Nome (ex.: Nubank)" Text="{Binding NewSourceName}" MaxLength="30" />

                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        AutomationId="SetupSourceBankAccountTypeButton"
                                        StrokeShape="RoundRectangle 18"
                                        Stroke="Purple"
                                        StrokeThickness="1"
                                        BackgroundColor="Transparent"
                                        Padding="6,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                            <Setter Property="BackgroundColor" Value="Purple" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectSourceTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.BankAccount}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="🏦 Conta" HorizontalOptions="Center" FontSize="13" TextColor="Purple">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Grid.Column="1"
                                        AutomationId="SetupSourceCreditCardTypeButton"
                                        StrokeShape="RoundRectangle 18"
                                        Stroke="Purple"
                                        StrokeThickness="1"
                                        BackgroundColor="Transparent"
                                        Padding="6,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.CreditCard}">
                                            <Setter Property="BackgroundColor" Value="Purple" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectSourceTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.CreditCard}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="💳 Cartão" HorizontalOptions="Center" FontSize="13" TextColor="Purple">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.CreditCard}">
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Grid.Column="2"
                                        AutomationId="SetupSourceMealVoucherTypeButton"
                                        StrokeShape="RoundRectangle 18"
                                        Stroke="Purple"
                                        StrokeThickness="1"
                                        BackgroundColor="Transparent"
                                        Padding="6,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                            <Setter Property="BackgroundColor" Value="Purple" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectSourceTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.MealVoucher}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="🍽️ Vale" HorizontalOptions="Center" FontSize="13" TextColor="Purple">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding NewSourceType}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>

                            <VerticalStackLayout Spacing="2">
                                <Label AutomationId="SetupSourceBalanceCaption"
                                       Text="{Binding NewSourceType, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Entry AutomationId="SetupSourceBalanceEntry" Keyboard="Numeric">
                                    <Entry.Behaviors>
                                        <behaviors:CurrencyMaskBehavior Value="{Binding NewSourceBalance}" />
                                    </Entry.Behaviors>
                                </Entry>
                            </VerticalStackLayout>

                            <Button AutomationId="SetupAddSourceButton"
                                    Text="Adicionar"
                                    BackgroundColor="Purple"
                                    Command="{Binding AddSourceCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Income -->
                <VerticalStackLayout AutomationId="SetupIncomeStep" Spacing="16" IsVisible="{Binding IsIncomeStep}">
                    <Label Text="Quanto você recebe por mês?" FontSize="24" FontAttributes="Bold" TextColor="Purple" />
                    <Label FontSize="14"
                           TextColor="#424242"
                           Text="O salário vira uma receita recorrente (&quot;Todo mês&quot;): ela aparece em todos os meses, sem precisar lançar de novo." />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Salário" FontSize="12" TextColor="Gray" />
                        <Entry AutomationId="SetupSalaryEntry" Keyboard="Numeric">
                            <Entry.Behaviors>
                                <behaviors:CurrencyMaskBehavior Value="{Binding Salary}" />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Dia do pagamento" FontSize="12" TextColor="Gray" />
                        <Picker AutomationId="SetupSalaryDayPicker"
                                Title="Dia do pagamento"
                                ItemsSource="{Binding DueDays}"
                                ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                SelectedItem="{Binding SalaryDay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAvailableSources}">
                        <Label Text="Recebido em" FontSize="12" TextColor="Gray" />
                        <Picker AutomationId="SetupSalarySourcePicker"
                                Title="Recebido em"
                                ItemsSource="{Binding AvailableSources}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                SelectedItem="{Binding SalarySource}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 4. House expenses -->
                <VerticalStackLayout AutomationId="SetupHouseExpensesStep" Spacing="12" IsVisible="{Binding IsHouseExpensesStep}">
                    <Label Text="Quais são os gastos fixos da casa?" FontSize="24" FontAttributes="Bold" TextColor="Purple" />
                    <Label FontSize="14"
                           TextColor="#424242"
                           Text="Marque os que você tem e informe o valor de um mês. Cada um vira uma despesa recorrente. Contas que mudam todo mês, como energia e água, ficam como valor estimado (±): você ajusta quando a conta chegar." />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupExpenseItem">
                                <Border AutomationId="SetupExpenseRow"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#E0E0E0"
                                        StrokeThickness="1"
                                        Padding="12,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="Purple" />
                                            <Setter Property="BackgroundColor" Value="#F7F2FC" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Tapping the row (re)selects it; the check box only mirrors the state -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpenseCommand, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label AutomationId="SetupExpenseNameLabel" Text="{Binding Description}" FontSize="15" />
                                                <Label Text="{Binding Hint}" FontSize="11" TextColor="Gray" IsVisible="{Binding HasHint}" />
                                            </VerticalStackLayout>
                                            <CheckBox Grid.Column="2"
                                                      AutomationId="SetupExpenseCheckBox"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      InputTransparent="True"
                                                      Color="Purple"
                                                      VerticalOptions="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding IsSelected}">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Valor mensal" FontSize="12" TextColor="Gray" />
                                                <Entry AutomationId="SetupExpenseAmountEntry" Keyboard="Numeric">
                                                    <Entry.Behaviors>
                                                        <behaviors:CurrencyMaskBehavior Value="{Binding Amount}" />
                                                    </Entry.Behaviors>
                                                </Entry>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" IsVisible="{Binding HasDueDay}">
                                                <Label Text="Vencimento" FontSize="12" TextColor="Gray" />
                                                <Picker AutomationId="SetupExpenseDueDayPicker"
                                                        Title="Vencimento"
                                                        ItemsSource="{Binding DueDays, Source={RelativeSource AncestorType={x:Type vm:SetupViewModel}}, x:DataType=vm:SetupViewModel}"
                                                        ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                                        SelectedItem="{Binding DueDay}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAvailableSources}">
                        <Label Text="Pago com" FontSize="12" TextColor="Gray" />
                        <Picker AutomationId="SetupExpensesSourcePicker"
                                Title="Pago com"
                                ItemsSource="{Binding AvailableSources}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                SelectedItem="{Binding ExpensesSource}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 5. Summary, and how entries work -->
                <VerticalStackLayout AutomationId="SetupSummaryStep" Spacing="16" IsVisible="{Binding IsSummaryStep}">
                    <Label AutomationId="SetupSummaryTitleLabel" Text="{Binding SummaryTitle}" FontSize="24" FontAttributes="Bold" TextColor="Purple" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSummaryRows}">
                        <Label Text="Estes lançamentos serão criados a partir deste mês:" FontSize="14" TextColor="#424242" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SummaryRows}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SetupSummaryRow">
                                    <Grid AutomationId="SetupSummaryRow" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" Padding="0,6">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label AutomationId="SetupSummaryDescriptionLabel" Text="{Binding Description}" FontSize="15" />
                                            <Label AutomationId="SetupSummaryDetailLabel" Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="SetupSummaryAmountLabel"
                                               Text="{Binding Amount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E0E0E0" />
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                            <Label Grid.Row="0" Text="Receitas por mês" FontSize="14" />
                            <Label Grid.Row="0" Grid.Column="1" AutomationId="SetupSummaryIncomeLabel"
                                   Text="{Binding TotalIncome, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14" TextColor="SeaGreen" />
                            <Label Grid.Row="1" Text="Despesas por mês" FontSize="14" />
                            <Label Grid.Row="1" Grid.Column="1" AutomationId="SetupSummaryOutcomeLabel"
                                   Text="{Binding TotalOutcome, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14" TextColor="Crimson" />
                            <Label Grid.Row="2" Text="Sobra no mês" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="1" AutomationId="SetupSummaryBalanceLabel"
                                   Text="{Binding Balance, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>

                    <Label AutomationId="SetupSummaryEmptyLabel"
                           Text="Nenhum lançamento será criado agora. Você pode adicioná-los quando quiser pelo botão +."
                           FontSize="14"
                           TextColor="#424242"
                           IsVisible="{Binding HasSummaryRows, Converter={x:Static converters:InverseBoolConverter.Instance}}" />

                    <Border AutomationId="SetupRecurrenceGuide"
                            BackgroundColor="#EDE7F6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Como funcionam os lançamentos" FontSize="15" FontAttributes="Bold" TextColor="Purple" />
                            <Label FontSize="13" TextColor="#424242">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Única: " FontAttributes="Bold" />
                                        <Span Text="acontece uma vez, como uma compra à vista." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#424242">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Todo mês (recorrente): " FontAttributes="Bold" />
                                        <Span Text="se repete todos os meses, sem data para acabar, como o salário e o aluguel." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#424242">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Parcelada: " FontAttributes="Bold" />
                                        <Span Text="se repete por um número fixo de meses, como uma compra em 10x." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#424242">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Valor estimado (±): " FontAttributes="Bold" />
                                        <Span Text="para contas que mudam a cada mês. Ajuste o valor quando a conta chegar." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#424242">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Pagamento parcial: " FontAttributes="Bold" />
                                        <Span Text="para gastos pagos aos poucos, como o mercado. Registre cada compra com &quot;Pagar parcial&quot;." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13"
                                   TextColor="#424242"
                                   Text="Toque em um lançamento para editá-lo e segure-o para marcar como pago ou excluir." />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10" Padding="20,8,20,16">
            <Button Grid.Column="0"
                    AutomationId="SetupBackButton"
                    Text="Voltar"
                    BackgroundColor="Gray"
                    IsVisible="{Binding IsFirstStep, Converter={x:Static converters:InverseBoolConverter.Instance}}"
                    Command="{Binding BackCommand}" />
            <Button Grid.Column="1"
                    AutomationId="SetupNextButton"
                    Text="{Binding NextButtonText}"
                    BackgroundColor="Purple"
                    Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</ContentPage>
