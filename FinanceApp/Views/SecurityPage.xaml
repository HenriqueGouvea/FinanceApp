<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             x:Class="FinanceApp.Views.SecurityPage"
             x:DataType="vm:SecurityViewModel"
             Title="Segurança">
    <ScrollView>
        <VerticalStackLayout Padding="12,14,12,24" Spacing="14">
            <!-- There is no account yet: the data can't be recovered elsewhere, but the app can still be locked -->
            <Border AutomationId="NoAccountNotice"
                    BackgroundColor="{StaticResource Secondary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Seus dados ficam só neste aparelho"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label FontSize="13"
                           Text="O Mensal ainda não tem conta de usuário. Sem ela, não é possível recuperar seus dados em outro aparelho nem acessá-los pelo site quando ele existir. Mesmo assim, você pode proteger o app com um PIN e com a biometria do aparelho." />
                    <Label FontSize="13"
                           Text="Guarde bem o PIN: sem conta, ele não pode ser recuperado." />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid AutomationId="PinLockRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPinLockTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Bloquear com PIN" Style="{StaticResource RowTitle}" />
                            <Label Text="Pedido ao abrir o app e ao voltar depois de 1 minuto fora dele" Style="{StaticResource Hint}" />
                        </VerticalStackLayout>
                        <!-- Mirrors the state only: the row tap opens the PIN keypad, which decides whether it changes -->
                        <Switch Grid.Column="1"
                                AutomationId="PinLockSwitch"
                                IsToggled="{Binding IsPinEnabled, Mode=OneWay}"
                                InputTransparent="True"
                                VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsPinEnabled}">
                        <BoxView HeightRequest="1" Margin="16,0" />
                        <Grid AutomationId="ChangePinRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePinTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="Alterar PIN" Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="16,0" />
                        <Grid AutomationId="BiometricRow" ColumnDefinitions="*, Auto" Style="{StaticResource CardRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleBiometricCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Desbloquear com biometria" Style="{StaticResource RowTitle}" />
                                <Label AutomationId="BiometricHintLabel"
                                       Text="{Binding BiometricHint}"
                                       Style="{StaticResource Hint}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    AutomationId="BiometricSwitch"
                                    IsToggled="{Binding IsBiometricEnabled, Mode=OneWay}"
                                    IsEnabled="{Binding IsBiometricAvailable}"
                                    InputTransparent="True"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
