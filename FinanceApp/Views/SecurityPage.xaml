<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             x:Class="FinanceApp.Views.SecurityPage"
             x:DataType="vm:SecurityViewModel"
             Title="Segurança">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <!-- There is no account yet: the data can't be recovered elsewhere, but the app can still be locked -->
            <Border AutomationId="NoAccountNotice"
                    BackgroundColor="#EDE7F6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Margin="0,0,0,12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Seus dados ficam só neste aparelho"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="Purple" />
                    <Label FontSize="13"
                           TextColor="#424242"
                           Text="O FinanceApp ainda não tem conta de usuário. Sem ela, não é possível recuperar seus dados em outro aparelho nem acessá-los pelo site quando ele existir. Mesmo assim, você pode proteger o app com um PIN e com a biometria do aparelho." />
                    <Label FontSize="13"
                           TextColor="#424242"
                           Text="Guarde bem o PIN: sem conta, ele não pode ser recuperado." />
                </VerticalStackLayout>
            </Border>

            <Grid AutomationId="PinLockRow" ColumnDefinitions="*, Auto" Padding="0,10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPinLockTapped" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Bloquear com PIN" FontSize="16" />
                    <Label Text="Pedido ao abrir o app e ao voltar depois de 1 minuto fora dele"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
                <!-- Mirrors the state only: the row tap opens the PIN keypad, which decides whether it changes -->
                <Switch Grid.Column="1"
                        AutomationId="PinLockSwitch"
                        IsToggled="{Binding IsPinEnabled, Mode=OneWay}"
                        InputTransparent="True"
                        OnColor="#CE93D8"
                        ThumbColor="Purple"
                        VerticalOptions="Center" />
            </Grid>

            <Grid AutomationId="ChangePinRow" Padding="0,10" IsVisible="{Binding IsPinEnabled}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChangePinTapped" />
                </Grid.GestureRecognizers>
                <Label Text="Alterar PIN" FontSize="16" VerticalOptions="Center" />
            </Grid>

            <Grid AutomationId="BiometricRow" ColumnDefinitions="*, Auto" Padding="0,10" IsVisible="{Binding IsPinEnabled}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleBiometricCommand}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Desbloquear com biometria" FontSize="16" />
                    <Label AutomationId="BiometricHintLabel"
                           Text="{Binding BiometricHint}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
                <Switch Grid.Column="1"
                        AutomationId="BiometricSwitch"
                        IsToggled="{Binding IsBiometricEnabled, Mode=OneWay}"
                        IsEnabled="{Binding IsBiometricAvailable}"
                        InputTransparent="True"
                        OnColor="#CE93D8"
                        ThumbColor="Purple"
                        VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
