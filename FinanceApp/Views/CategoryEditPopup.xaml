<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               xmlns:vm="clr-namespace:FinanceApp.ViewModels"
               xmlns:converters="clr-namespace:FinanceApp.Converters"
               x:Class="FinanceApp.Views.CategoryEditPopup"
               x:DataType="vm:CategoryEditViewModel">

    <Border Style="{StaticResource PopupCard}"
            WidthRequest="350"
            MaximumHeightRequest="620"
            VerticalOptions="Center">

        <ScrollView>
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding PopupTitle}" Style="{StaticResource PopupTitle}" />

                <!-- Live preview -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="48" HeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{Binding Color, Converter={x:Static converters:HexToColorConverter.Instance}}">
                        <Label Text="{Binding Icon}" FontSize="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"
                           TextColor="{Binding Color, Converter={x:Static converters:HexToColorConverter.Instance}}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Entry x:Name="NameEntry" AutomationId="CategoryNameEntry" Placeholder="Nome" Text="{Binding Name}" MaxLength="30" />

                <!-- Category type: decides whether the category is offered for outcomes or incomes -->
                <Border Style="{StaticResource SegmentedControl}">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="3">
                        <Border Grid.Column="0"
                                AutomationId="CategoryOutcomeTypeButton"
                                Style="{StaticResource SegmentOption}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncome}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Outcome}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectOutcomeCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Despesa" Style="{StaticResource SegmentLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="False">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="1"
                                AutomationId="CategoryIncomeTypeButton"
                                Style="{StaticResource SegmentOption}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncome}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Income}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectIncomeCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Receita" Style="{StaticResource SegmentLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </Border>

                <Label Text="Ícone" FontSize="13" TextColor="{StaticResource Muted}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Icons}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid WidthRequest="38" HeightRequest="38" Margin="1">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectIconCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}, x:DataType=vm:CategoryEditViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border StrokeThickness="2" Stroke="{StaticResource PrimaryBrush}" BackgroundColor="{StaticResource Secondary}"
                                        StrokeShape="RoundRectangle 8">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static converters:AreEqualConverter.Instance}">
                                            <Binding Path="." />
                                            <Binding Path="Icon"
                                                     Source="{RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}"
                                                     x:DataType="vm:CategoryEditViewModel" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>
                                <Label Text="{Binding .}" FontSize="20"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Cor" FontSize="13" TextColor="{StaticResource Muted}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Colors}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid WidthRequest="38" HeightRequest="38" Margin="1">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}, x:DataType=vm:CategoryEditViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border StrokeThickness="2" Stroke="{StaticResource InkBrush}" BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 19">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static converters:AreEqualConverter.Instance}">
                                            <Binding Path="." />
                                            <Binding Path="Color"
                                                     Source="{RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}"
                                                     x:DataType="vm:CategoryEditViewModel" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>
                                <Border WidthRequest="28" HeightRequest="28"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{Binding ., Converter={x:Static converters:HexToColorConverter.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelClicked" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1" AutomationId="SaveCategoryButton" Text="Salvar" Command="{Binding SaveCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
