<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             x:Class="FinanceApp.Views.PaymentSourcesPage"
             x:DataType="vm:PaymentSourcesViewModel"
             Title="Contas e cartões">
    <Grid>
        <CollectionView ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        SelectionMode="None"
                        Margin="0,6,0,0">
            <CollectionView.EmptyView>
                <Label AutomationId="PaymentSourcesEmptyLabel"
                       Text="Nenhuma conta ou cartão cadastrado. Toque em + para criar."
                       TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center"
                       Margin="30" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:PaymentSourceGroup">
                    <Label AutomationId="PaymentSourceGroupHeader"
                           Text="{Binding Title}"
                           Style="{StaticResource GroupHeader}"
                           Padding="20,14,20,6" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PaymentSourceSummary">
                    <!-- Each source is a white card; tapping it opens it for editing -->
                    <ContentView Padding="12,4">
                        <Border Style="{StaticResource Card}">
                            <Grid AutomationId="PaymentSourceRow" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="14,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPaymentSourceTapped" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0"
                                        WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{StaticResource Secondary}">
                                    <Label Text="{Binding Source.Type, Converter={x:Static converters:PaymentSourceTypeToIconConverter.Instance}}"
                                           FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label AutomationId="PaymentSourceNameLabel"
                                           Text="{Binding Source.Name}"
                                           FontSize="15"
                                           FontFamily="OpenSansSemibold" />
                                    <!-- "Saldo" for accounts and vouchers, "Limite" for credit cards -->
                                    <Label AutomationId="PaymentSourceBalanceLabel" FontSize="12" TextColor="{StaticResource Muted}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="Source.Type" Converter="{x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}" />
                                                <Binding Path="Source.Balance" Converter="{x:Static converters:MoneyConverter.Instance}" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <!-- Credit cards: the limit minus what is unpaid on its bills and the installments still to come -->
                                    <Label AutomationId="PaymentSourceAvailableLimitLabel"
                                           Text="{Binding AvailableLimit, Converter={x:Static converters:MoneyConverter.Instance}, StringFormat='Disponível: {0}'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Income}"
                                           IsVisible="{Binding IsCreditCard}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverLimit}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Outcome}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        AutomationId="DeletePaymentSourceButton"
                                        BackgroundColor="{StaticResource OutcomeTint}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,7"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDeletePaymentSourceClicked" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Excluir" TextColor="{StaticResource Outcome}" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <ContentView HeightRequest="96" />
            </CollectionView.Footer>
        </CollectionView>

        <Button AutomationId="AddPaymentSourceButton"
                Style="{StaticResource FabButton}"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
