<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               xmlns:vm="clr-namespace:FinanceApp.ViewModels"
               x:Class="FinanceApp.Views.MonthPickerPopup"
               x:DataType="vm:MonthPickerViewModel">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 12"
            Padding="20"
            WidthRequest="330"
            VerticalOptions="Center">

        <VerticalStackLayout Spacing="15">
            <!-- Year selector -->
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0"
                        AutomationId="PreviousYearButton"
                        Text="‹"
                        FontSize="22"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        CornerRadius="22"
                        BackgroundColor="#EDE7F6"
                        TextColor="Purple"
                        Command="{Binding PreviousYearCommand}" />
                <Label Grid.Column="1"
                       AutomationId="PickerYearLabel"
                       Text="{Binding Year}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        AutomationId="NextYearButton"
                        Text="›"
                        FontSize="22"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        CornerRadius="22"
                        BackgroundColor="#EDE7F6"
                        TextColor="Purple"
                        Command="{Binding NextYearCommand}" />
            </Grid>

            <!-- Month grid (3 x 4) -->
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding MonthOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonthOption">
                        <Border AutomationId="MonthOption"
                                WidthRequest="90"
                                HeightRequest="44"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                StrokeThickness="2"
                                BackgroundColor="#F5F5F5"
                                IsEnabled="{Binding IsEnabled}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Stroke" Value="Purple" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="Purple" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectMonthCommand, Source={RelativeSource AncestorType={x:Type vm:MonthPickerViewModel}}, x:DataType=vm:MonthPickerViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label AutomationId="MonthOptionLabel"
                                   Text="{Binding Label}"
                                   FontSize="15"
                                   TextColor="Black"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0" AutomationId="CancelMonthPickerButton" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Gray" />
                <Button Grid.Column="1" AutomationId="PickerCurrentMonthButton" Text="Mês atual" Command="{Binding SelectCurrentMonthCommand}" BackgroundColor="Purple" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
