<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               xmlns:vm="clr-namespace:FinanceApp.ViewModels"
               xmlns:models="clr-namespace:FinanceApp.Models"
               xmlns:converters="clr-namespace:FinanceApp.Converters"
               xmlns:behaviors="clr-namespace:FinanceApp.Behaviors"
               x:Class="FinanceApp.Views.AddEntryPopup"
               x:DataType="vm:AddEntryViewModel">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 12"
            Padding="20"
            WidthRequest="350"
            MaximumHeightRequest="560"
            VerticalOptions="Center">

        <ScrollView>
        <VerticalStackLayout Spacing="15">
            <Label AutomationId="EntryPopupTitleLabel" Text="{Binding PopupTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

            <Entry x:Name="DescriptionEntry" AutomationId="DescriptionEntry" Placeholder="Descrição" Text="{Binding Description}" />

            <!-- Entry type swipe/tap toggle — disabled when editing (structural field) -->
            <Frame AutomationId="EntryTypeToggle" CornerRadius="22" Padding="3" BorderColor="LightGray"
                   BackgroundColor="#F0F0F0" HasShadow="False"
                   IsEnabled="{Binding IsEditing, Converter={x:Static converters:InverseBoolConverter.Instance}}"
                   Opacity="{Binding StructuralFieldsOpacity}">
                <Frame.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Right" Command="{Binding SelectIncomeCommand}" />
                    <SwipeGestureRecognizer Direction="Left"  Command="{Binding SelectOutcomeCommand}" />
                </Frame.GestureRecognizers>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="3">

                    <!-- Outcome (Despesa) column -->
                    <Grid Grid.Column="0">
                        <!-- Active state -->
                        <Frame CornerRadius="19" BackgroundColor="Crimson" Padding="10,8"
                               HasShadow="False" BorderColor="Transparent"
                               IsVisible="{Binding IsIncome, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                            <Label Text="Despesa" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" FontSize="13" />
                        </Frame>
                        <!-- Inactive state — tappable -->
                        <Frame AutomationId="SelectOutcomeButton"
                               CornerRadius="19" BackgroundColor="Transparent" Padding="10,8"
                               HasShadow="False" BorderColor="Transparent"
                               IsVisible="{Binding IsIncome}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectOutcomeCommand}" />
                            </Frame.GestureRecognizers>
                            <Label Text="Despesa" TextColor="Gray"
                                   HorizontalOptions="Center" FontSize="13" />
                        </Frame>
                    </Grid>

                    <!-- Income (Receita) column -->
                    <Grid Grid.Column="1">
                        <!-- Active state -->
                        <Frame CornerRadius="19" BackgroundColor="SeaGreen" Padding="10,8"
                               HasShadow="False" BorderColor="Transparent"
                               IsVisible="{Binding IsIncome}">
                            <Label Text="Receita" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" FontSize="13" />
                        </Frame>
                        <!-- Inactive state — tappable -->
                        <Frame AutomationId="SelectIncomeButton"
                               CornerRadius="19" BackgroundColor="Transparent" Padding="10,8"
                               HasShadow="False" BorderColor="Transparent"
                               IsVisible="{Binding IsIncome, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectIncomeCommand}" />
                            </Frame.GestureRecognizers>
                            <Label Text="Receita" TextColor="Gray"
                                   HorizontalOptions="Center" FontSize="13" />
                        </Frame>
                    </Grid>

                </Grid>
            </Frame>

            <!-- Recurrence — disabled when editing (structural field) -->
            <Picker AutomationId="RecurrencePicker"
                    Title="Recorrência"
                    ItemsSource="{Binding RecurrenceTypes}"
                    ItemDisplayBinding="{Binding ., Converter={x:Static converters:RecurrenceTypeToLabelConverter.Instance}, x:DataType=models:RecurrenceType}"
                    SelectedItem="{Binding SelectedRecurrence}"
                    IsEnabled="{Binding IsEditing, Converter={x:Static converters:InverseBoolConverter.Instance}}"
                    Opacity="{Binding StructuralFieldsOpacity}" />

            <Entry AutomationId="InstallmentsEntry"
                   Placeholder="Nº de parcelas"
                   Text="{Binding TotalInstallments}"
                   Keyboard="Numeric"
                   IsVisible="{Binding IsInstallments}" />

            <!-- Amount — only shown once the recurrence defines what the amount means -->
            <VerticalStackLayout Spacing="2" IsVisible="{Binding HasRecurrence}">
                <Label Text="{Binding SelectedRecurrence, Converter={x:Static converters:RecurrenceTypeToAmountLabelConverter.Instance}}"
                       FontSize="12"
                       TextColor="Gray" />
                <Entry AutomationId="AmountEntry"
                       Placeholder="{Binding SelectedRecurrence, Converter={x:Static converters:RecurrenceTypeToAmountLabelConverter.Instance}}"
                       Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:CurrencyMaskBehavior Value="{Binding Amount}" />
                    </Entry.Behaviors>
                </Entry>
                <Label AutomationId="InstallmentsTotalLabel"
                       Text="{Binding InstallmentsTotal, Converter={x:Static converters:MoneyConverter.Instance}, StringFormat='Total: {0}'}"
                       FontSize="12"
                       TextColor="Gray"
                       IsVisible="{Binding InstallmentsTotal, Converter={x:Static converters:IsNotNullConverter.Instance}}" />

                <!-- Estimated: the amount changes every month (e.g. energy bill, supermarket) -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Valor estimado" FontSize="14" />
                        <Label Text="Varia a cada mês, como luz ou mercado" FontSize="11" TextColor="Gray" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            AutomationId="EstimatedSwitch"
                            IsToggled="{Binding IsEstimated}"
                            OnColor="#B39DDB"
                            ThumbColor="Purple"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Partial payment for the month the entry was opened from (e.g. supermarket spent so far) -->
            <VerticalStackLayout Spacing="2" IsVisible="{Binding IsEditing}">
                <Label AutomationId="PaidAmountLabel"
                       Text="{Binding PaidAmountLabel}"
                       FontSize="12"
                       TextColor="Gray" />
                <Entry AutomationId="PaidAmountEntry"
                       Placeholder="{Binding PaidAmountLabel}"
                       Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:CurrencyMaskBehavior Value="{Binding PaidAmount}" />
                    </Entry.Behaviors>
                </Entry>
            </VerticalStackLayout>

            <Picker AutomationId="CategoryPicker"
                    Title="Categoria"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:FinancialCategory}"
                    SelectedItem="{Binding SelectedCategory}" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" AutomationId="CancelEntryButton" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Gray" />
                <Button Grid.Column="1" AutomationId="SaveEntryButton" Text="Salvar" Command="{Binding SaveCommand}" BackgroundColor="Purple" />
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
