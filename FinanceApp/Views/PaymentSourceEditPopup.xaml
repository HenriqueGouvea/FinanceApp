<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               xmlns:vm="clr-namespace:FinanceApp.ViewModels"
               xmlns:models="clr-namespace:FinanceApp.Models"
               xmlns:converters="clr-namespace:FinanceApp.Converters"
               xmlns:behaviors="clr-namespace:FinanceApp.Behaviors"
               x:Class="FinanceApp.Views.PaymentSourceEditPopup"
               x:DataType="vm:PaymentSourceEditViewModel">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 12"
            Padding="20"
            WidthRequest="350"
            MaximumHeightRequest="620"
            VerticalOptions="Center">

        <ScrollView>
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding PopupTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

                <Entry x:Name="NameEntry" AutomationId="PaymentSourceNameEntry" Placeholder="Nome (ex.: Nubank)" Text="{Binding Name}" MaxLength="30" />

                <!-- Source type: decides whether the amount below is a balance or a credit limit -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            AutomationId="PaymentSourceBankAccountTypeButton"
                            StrokeShape="RoundRectangle 18"
                            Stroke="{StaticResource PrimaryBrush}"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="6,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.BankAccount}" />
                        </Border.GestureRecognizers>
                        <Label Text="🏦 Conta" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Grid.Column="1"
                            AutomationId="PaymentSourceCreditCardTypeButton"
                            StrokeShape="RoundRectangle 18"
                            Stroke="{StaticResource PrimaryBrush}"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="6,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.CreditCard}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.CreditCard}" />
                        </Border.GestureRecognizers>
                        <Label Text="💳 Cartão de crédito" HorizontalOptions="Center" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.CreditCard}">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Grid.Column="2"
                            AutomationId="PaymentSourceMealVoucherTypeButton"
                            StrokeShape="RoundRectangle 18"
                            Stroke="{StaticResource PrimaryBrush}"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="6,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.MealVoucher}" />
                        </Border.GestureRecognizers>
                        <Label Text="🍽️ Vale" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Label AutomationId="PaymentSourceBalanceFieldLabel"
                           Text="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                           FontSize="12"
                           TextColor="Gray" />
                    <Entry AutomationId="PaymentSourceBalanceEntry"
                           Placeholder="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                           Keyboard="Numeric">
                        <Entry.Behaviors>
                            <behaviors:CurrencyMaskBehavior Value="{Binding Balance}" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>

                <!-- Credit cards only: the bill groups the month's card outcomes, due on one day and paid by a bank account -->
                <VerticalStackLayout AutomationId="CreditCardBillFields" Spacing="10" IsVisible="{Binding IsCreditCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Vencimento da fatura" FontSize="12" TextColor="Gray" />
                        <Picker AutomationId="BillDueDayPicker"
                                Title="Vencimento da fatura"
                                ItemsSource="{Binding BillDueDays}"
                                ItemDisplayBinding="{Binding ., Converter={x:Static converters:DueDayToLabelConverter.Instance}, x:DataType=x:Int32}"
                                SelectedItem="{Binding BillDueDay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Fatura paga com" FontSize="12" TextColor="Gray" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6" IsVisible="{Binding HasBillPaymentAccounts}">
                            <Picker AutomationId="BillPaymentAccountPicker"
                                    Title="Fatura paga com"
                                    ItemsSource="{Binding BillPaymentAccounts}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=models:PaymentSource}"
                                    SelectedItem="{Binding BillPaymentAccount}" />
                            <Button Grid.Column="1"
                                    AutomationId="ClearBillPaymentAccountButton"
                                    Text="✕"
                                    FontSize="14"
                                    Padding="0"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="Transparent"
                                    TextColor="Gray"
                                    Command="{Binding ClearBillPaymentAccountCommand}"
                                    IsVisible="{Binding HasBillPaymentAccount}" />
                        </Grid>
                        <Label AutomationId="NoBillPaymentAccountsLabel"
                               Text="Cadastre uma conta bancária para escolher qual paga a fatura."
                               FontSize="12"
                               TextColor="Gray"
                               IsVisible="{Binding HasBillPaymentAccounts, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                    </VerticalStackLayout>

                    <Label Text="Os lançamentos pagos com este cartão de crédito aparecem juntos na fatura do mês, com um só vencimento."
                           FontSize="11"
                           TextColor="Gray" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" AutomationId="CancelPaymentSourceButton" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Gray" />
                    <Button Grid.Column="1" AutomationId="SavePaymentSourceButton" Text="Salvar" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
