<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               xmlns:vm="clr-namespace:FinanceApp.ViewModels"
               xmlns:models="clr-namespace:FinanceApp.Models"
               xmlns:converters="clr-namespace:FinanceApp.Converters"
               xmlns:behaviors="clr-namespace:FinanceApp.Behaviors"
               x:Class="FinanceApp.Views.PaymentSourceEditPopup"
               x:DataType="vm:PaymentSourceEditViewModel">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 12"
            Padding="20"
            WidthRequest="350"
            MaximumHeightRequest="620"
            VerticalOptions="Center">

        <ScrollView>
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding PopupTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

                <Entry x:Name="NameEntry" AutomationId="PaymentSourceNameEntry" Placeholder="Nome (ex.: Nubank)" Text="{Binding Name}" MaxLength="30" />

                <!-- Source type: decides whether the amount below is a balance or a credit limit -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            AutomationId="PaymentSourceBankAccountTypeButton"
                            StrokeShape="RoundRectangle 18"
                            Stroke="Purple"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="6,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                <Setter Property="BackgroundColor" Value="Purple" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.BankAccount}" />
                        </Border.GestureRecognizers>
                        <Label Text="🏦 Conta" HorizontalOptions="Center" FontSize="13" TextColor="Purple">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.BankAccount}">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Grid.Column="1"
                            AutomationId="PaymentSourceCreditCardTypeButton"
                            StrokeShape="RoundRectangle 18"
                            Stroke="Purple"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="6,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.CreditCard}">
                                <Setter Property="BackgroundColor" Value="Purple" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.CreditCard}" />
                        </Border.GestureRecognizers>
                        <Label Text="💳 Cartão" HorizontalOptions="Center" FontSize="13" TextColor="Purple">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.CreditCard}">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Grid.Column="2"
                            AutomationId="PaymentSourceMealVoucherTypeButton"
                            StrokeShape="RoundRectangle 18"
                            Stroke="Purple"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="6,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                <Setter Property="BackgroundColor" Value="Purple" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:PaymentSourceType.MealVoucher}" />
                        </Border.GestureRecognizers>
                        <Label Text="🍽️ Vale" HorizontalOptions="Center" FontSize="13" TextColor="Purple">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:PaymentSourceType.MealVoucher}">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Label AutomationId="PaymentSourceBalanceFieldLabel"
                           Text="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                           FontSize="12"
                           TextColor="Gray" />
                    <Entry AutomationId="PaymentSourceBalanceEntry"
                           Placeholder="{Binding Type, Converter={x:Static converters:PaymentSourceTypeToBalanceLabelConverter.Instance}}"
                           Keyboard="Numeric">
                        <Entry.Behaviors>
                            <behaviors:CurrencyMaskBehavior Value="{Binding Balance}" />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Gray" />
                    <Button Grid.Column="1" AutomationId="SavePaymentSourceButton" Text="Salvar" Command="{Binding SaveCommand}" BackgroundColor="Purple" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
