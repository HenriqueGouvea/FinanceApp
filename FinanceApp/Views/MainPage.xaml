<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:FinanceApp.Controls"
             x:Class="FinanceApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Lançamentos">
    <ContentPage.Resources>
        <Color x:Key="OutcomeAccent">#D32F2F</Color>
        <Color x:Key="OutcomeTint">#FDECEC</Color>
        <Color x:Key="IncomeAccent">#2E7D32</Color>
        <Color x:Key="IncomeTint">#E8F5E9</Color>

        <DataTemplate x:Key="EntryRowTemplate" x:DataType="models:MonthlyEntryProjection">
            <Grid IsClippedToBounds="True">
                <Grid AutomationId="EntryRow" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" Padding="14,10">
                    <Grid.Behaviors>
                        <toolkit:TouchBehavior LongPressDuration="1000"
                                               TouchGestureCompleted="OnEntryTapped"
                                               LongPressCompleted="OnEntryLongPressed" />
                    </Grid.Behaviors>

                    <!-- Status indicator: empty ring while pending, filled check once paid/received -->
                    <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                        <Border AutomationId="EntryPendingIcon"
                                StrokeShape="RoundRectangle 11"
                                Stroke="#BDBDBD"
                                StrokeThickness="2"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsPaid, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                        <Border AutomationId="EntryPaidIcon"
                                StrokeShape="RoundRectangle 11"
                                StrokeThickness="0"
                                BackgroundColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                                IsVisible="{Binding IsPaid}">
                            <Label Text="✓"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1">
                        <Label AutomationId="EntryDescriptionLabel" Text="{Binding Description}" FontAttributes="Bold"/>
                        <HorizontalStackLayout Spacing="4"
                                               IsVisible="{Binding Category, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                            <Label Text="{Binding Category.Icon}" FontSize="11"/>
                            <Label AutomationId="EntryCategoryLabel"
                                   Text="{Binding Category.Name}"
                                   FontSize="11"
                                   TextColor="{Binding Category.Color, Converter={x:Static converters:HexToColorConverter.Instance}}"/>
                        </HorizontalStackLayout>
                        <Label AutomationId="EntryInstallmentLabel"
                               FontSize="11"
                               TextColor="Gray"
                               IsVisible="{Binding InstallmentLabel, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} · Total R$ {1:F2}">
                                    <Binding Path="InstallmentLabel" />
                                    <Binding Path="InstallmentTotalAmount" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           AutomationId="EntryStatusLabel"
                           Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToPaidLabelConverter.Instance}}"
                           TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                           FontSize="11"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsPaid}"/>
                    <Label Grid.Column="3"
                           AutomationId="EntryAmountLabel"
                           Text="{Binding EffectiveAmount, StringFormat='R$ {0:F2}'}"
                           TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Entry actions menu, slides in on long press -->
                <controls:SlideOutPanel HorizontalOptions="End"
                                        BackgroundColor="#EEEEEE"
                                        Padding="6">
                    <controls:SlideOutPanel.IsOpen>
                        <MultiBinding Converter="{x:Static converters:AreEqualConverter.Instance}">
                            <Binding Path="FinancialEntryId" />
                            <Binding Path="RevealedEntryId"
                                     Source="{RelativeSource AncestorType={x:Type vm:MonthViewModel}}"
                                     x:DataType="vm:MonthViewModel" />
                        </MultiBinding>
                    </controls:SlideOutPanel.IsOpen>
                    <HorizontalStackLayout Spacing="6">
                        <Border AutomationId="MarkPaidEntryAction"
                                BackgroundColor="#2E7D32"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0"
                                IsVisible="{Binding IsPaid, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleStatusClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToMarkPaidLabelConverter.Instance}}"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="MarkPendingEntryAction"
                                BackgroundColor="#757575"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0"
                                IsVisible="{Binding IsPaid}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleStatusClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Pendente"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="DeleteEntryAction"
                                BackgroundColor="#D32F2F"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteEntryClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Excluir"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </controls:SlideOutPanel>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <!-- Programmatic jumps (month picker, "Mês atual") would otherwise animate through every month in between -->
        <CarouselView ItemsSource="{Binding Months}"
                      Position="{Binding CurrentPosition, Mode=TwoWay}"
                      IsScrollAnimated="False"
                      Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthViewModel">
                    <ScrollView x:Name="monthScroll">
                        <VerticalStackLayout Padding="20"
                                             Spacing="15"
                                             MinimumHeightRequest="{Binding Height, Source={x:Reference monthScroll}, x:DataType=ScrollView}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <!-- Month Title: tap to pick any month/year -->
                            <HorizontalStackLayout AutomationId="MonthTitleButton"
                                                   HorizontalOptions="Center"
                                                   Spacing="8">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label AutomationId="MonthTitleLabel"
                                       Text="{Binding MonthName}"
                                       FontSize="32"
                                       FontAttributes="Bold" />
                                <Label Text="▾"
                                       FontSize="22"
                                       TextColor="Purple"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Summary Bar -->
                            <!-- Input transparent so taps reach the page's "tap outside" recognizer that hides the entry actions -->
                            <Frame AutomationId="SummaryBar" InputTransparent="True" BackgroundColor="#F0F0F0" CornerRadius="10" Padding="15">
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="30">
                                    <VerticalStackLayout>
                                        <Label Text="Receitas" FontSize="12" TextColor="Gray"/>
                                        <Label AutomationId="SummaryIncomeLabel" Text="{Binding TotalIncomes, StringFormat='R$ {0:F2}'}" TextColor="Green" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Text="Despesas" FontSize="12" TextColor="Gray"/>
                                        <Label AutomationId="SummaryOutcomeLabel" Text="{Binding TotalOutcomes, StringFormat='R$ {0:F2}'}" TextColor="Red" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Text="Balanço" FontSize="12" TextColor="Gray"/>
                                        <Label AutomationId="SummaryBalanceLabel" Text="{Binding Balance, StringFormat='R$ {0:F2}'}" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- Outcomes Section -->
                            <Border Stroke="{StaticResource OutcomeAccent}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White"
                                    Padding="0"
                                    Margin="0,10,0,0">
                                <VerticalStackLayout>
                                    <Grid AutomationId="OutcomesHeader"
                                          ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12"
                                          Padding="0,0,12,0"
                                          BackgroundColor="{StaticResource OutcomeTint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleOutcomesCommand}" />
                                        </Grid.GestureRecognizers>
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="5"
                                                 Color="{StaticResource OutcomeAccent}" />
                                        <VerticalStackLayout Grid.Column="1" Padding="0,10">
                                            <Label Text="Despesas"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   TextColor="{StaticResource OutcomeAccent}"/>
                                            <Label AutomationId="OutcomeCountLabel"
                                                   Text="{Binding OutcomeCount, StringFormat='{0} lançamento(s)'}"
                                                   TextColor="Gray"
                                                   FontSize="11"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="OutcomeTotalLabel"
                                               Text="{Binding TotalOutcomes, StringFormat='R$ {0:F2}'}"
                                               TextColor="{StaticResource OutcomeAccent}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                        <controls:ExpandChevron Grid.Column="3"
                                                                IsExpanded="{Binding IsOutcomesExpanded}"
                                                                AccentColor="{StaticResource OutcomeAccent}" />
                                    </Grid>

                                    <CollectionView ItemsSource="{Binding OutcomeEntries}"
                                                    ItemTemplate="{StaticResource EntryRowTemplate}"
                                                    IsVisible="{Binding IsOutcomesExpanded}"
                                                    SelectionMode="None" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Incomes Section -->
                            <Border Stroke="{StaticResource IncomeAccent}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White"
                                    Padding="0"
                                    Margin="0,10,0,0">
                                <VerticalStackLayout>
                                    <Grid AutomationId="IncomesHeader"
                                          ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12"
                                          Padding="0,0,12,0"
                                          BackgroundColor="{StaticResource IncomeTint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleIncomesCommand}" />
                                        </Grid.GestureRecognizers>
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="5"
                                                 Color="{StaticResource IncomeAccent}" />
                                        <VerticalStackLayout Grid.Column="1" Padding="0,10">
                                            <Label Text="Receitas"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   TextColor="{StaticResource IncomeAccent}"/>
                                            <Label AutomationId="IncomeCountLabel"
                                                   Text="{Binding IncomeCount, StringFormat='{0} lançamento(s)'}"
                                                   TextColor="Gray"
                                                   FontSize="11"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="IncomeTotalLabel"
                                               Text="{Binding TotalIncomes, StringFormat='R$ {0:F2}'}"
                                               TextColor="{StaticResource IncomeAccent}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                        <controls:ExpandChevron Grid.Column="3"
                                                                IsExpanded="{Binding IsIncomesExpanded}"
                                                                AccentColor="{StaticResource IncomeAccent}" />
                                    </Grid>

                                    <CollectionView ItemsSource="{Binding IncomeEntries}"
                                                    ItemTemplate="{StaticResource EntryRowTemplate}"
                                                    IsVisible="{Binding IsIncomesExpanded}"
                                                    SelectionMode="None" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bottom padding so FAB doesn't overlap last item -->
                            <BoxView HeightRequest="80" IsVisible="False" />

                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <Button Text="Nuke DB"
                Command="{Binding ClearDatabaseCommand}"
                FontSize="10"
                HeightRequest="30"
                WidthRequest="70"
                BackgroundColor="#33FF0000"
                TextColor="Red"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="20,0,0,33" />
        <Button AutomationId="GoToCurrentMonthButton"
                Text="{Binding GoToCurrentMonthLabel}"
                Command="{Binding GoToCurrentMonthCommand}"
                IsVisible="{Binding IsAwayFromCurrentMonth}"
                FontSize="13"
                HeightRequest="40"
                Padding="16,0"
                CornerRadius="20"
                BackgroundColor="#EDE7F6"
                TextColor="Purple"
                BorderColor="Purple"
                BorderWidth="1"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,28" />
        <Button AutomationId="AddEntryButton"
                Text="+"
                FontSize="24"
                BackgroundColor="Purple"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
