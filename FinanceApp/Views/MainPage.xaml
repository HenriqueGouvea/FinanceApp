<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:FinanceApp.Controls"
             x:Class="FinanceApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Lançamentos">
    <ContentPage.Resources>
        <Color x:Key="OutcomeAccent">#D32F2F</Color>
        <Color x:Key="OutcomeTint">#FDECEC</Color>
        <Color x:Key="IncomeAccent">#2E7D32</Color>
        <Color x:Key="IncomeTint">#E8F5E9</Color>
        <!-- Same for incomes and outcomes: a paid outcome is good news, so it must not use the red outcome accent -->
        <Color x:Key="PaidAccent">#2E7D32</Color>
        <Color x:Key="PartialAccent">#EF6C00</Color>
        <Color x:Key="PaidProgressFill">#81C784</Color>
        <Color x:Key="EstimatedAccent">#455A64</Color>
        <Color x:Key="EstimatedTint">#ECEFF1</Color>
        <Color x:Key="MonthNavAccent">#6A1B9A</Color>
        <Color x:Key="MonthNavTint">#EDE7F6</Color>
        <Style x:Key="MonthArrowButton" TargetType="Button">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BackgroundColor" Value="{StaticResource MonthNavTint}" />
            <Setter Property="TextColor" Value="{StaticResource MonthNavAccent}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="EntryRowTemplate" x:DataType="models:MonthlyEntryProjection">
            <Grid IsClippedToBounds="True">
                <Grid AutomationId="EntryRow" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" Padding="14,10">
                    <Grid.Behaviors>
                        <toolkit:TouchBehavior LongPressDuration="1000"
                                               TouchGestureCompleted="OnEntryTapped"
                                               LongPressCompleted="OnEntryLongPressed" />
                    </Grid.Behaviors>

                    <!-- Status indicator: empty ring while pending, ring with a dot when partially paid, filled check once paid/received -->
                    <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                        <Border AutomationId="EntryPendingIcon"
                                StrokeShape="RoundRectangle 11"
                                Stroke="#BDBDBD"
                                StrokeThickness="2"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsPending}" />
                        <Border AutomationId="EntryPartialIcon"
                                StrokeShape="RoundRectangle 11"
                                Stroke="{StaticResource PartialAccent}"
                                StrokeThickness="2"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsPartiallyPaid}">
                            <Border StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource PartialAccent}"
                                    WidthRequest="10"
                                    HeightRequest="10"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="EntryPaidIcon"
                                StrokeShape="RoundRectangle 11"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource PaidAccent}"
                                IsVisible="{Binding IsPaid}">
                            <Label Text="✓"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label AutomationId="EntryDescriptionLabel" Text="{Binding Description}" FontAttributes="Bold"/>
                        <HorizontalStackLayout Spacing="4"
                                               IsVisible="{Binding Category, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                            <Label Text="{Binding Category.Icon}" FontSize="11"/>
                            <Label AutomationId="EntryCategoryLabel"
                                   Text="{Binding Category.Name}"
                                   FontSize="11"
                                   TextColor="{Binding Category.Color, Converter={x:Static converters:HexToColorConverter.Instance}}"/>
                        </HorizontalStackLayout>
                        <!-- Turns red while it is due today and not yet paid/received -->
                        <Label AutomationId="EntryDueDateLabel"
                               Text="{Binding DueDate, Converter={x:Static converters:DueDateToLabelConverter.Instance}}"
                               FontSize="11"
                               TextColor="Gray"
                               IsVisible="{Binding HasDueDate}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDueToday}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource OutcomeAccent}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label AutomationId="EntryInstallmentLabel"
                               FontSize="11"
                               TextColor="Gray"
                               IsVisible="{Binding InstallmentLabel, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} · Total {1}">
                                    <Binding Path="InstallmentLabel" />
                                    <Binding Path="InstallmentTotalAmount" Converter="{x:Static converters:MoneyConverter.Instance}" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           AutomationId="EntryStatusLabel"
                           Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToPaidLabelConverter.Instance}}"
                           TextColor="{StaticResource PaidAccent}"
                           FontSize="11"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsPaid}"/>
                    <!-- Everything about the amount stays on the right, the price first and the payment progress below it -->
                    <VerticalStackLayout Grid.Column="3" Spacing="2" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                            <!-- Estimated amounts (±) vary each month (e.g. energy bill, supermarket) -->
                            <Border AutomationId="EntryEstimatedIcon"
                                    BackgroundColor="{StaticResource EstimatedTint}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsEstimated}">
                                <Label Text="±"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource EstimatedAccent}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label AutomationId="EntryAmountLabel"
                                   Text="{Binding EffectiveAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label AutomationId="EntryPartialLabel"
                               Text="{Binding PaidAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PartialAccent}"
                               HorizontalOptions="End"
                               IsVisible="{Binding ShowsPaidSoFar}" />
                        <!-- Paid beyond the planned amount (e.g. a supermarket above its estimate): the price above is what was paid -->
                        <Label AutomationId="EntryPlannedAmountLabel"
                               FontSize="11"
                               HorizontalOptions="End"
                               IsVisible="{Binding IsOverBudget}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="▲ "
                                          FontAttributes="Bold"
                                          TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}" />
                                    <Span Text="{Binding PlannedOrEffectiveAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                          TextColor="Gray"
                                          TextDecorations="Strikethrough" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <controls:PaymentProgressBar AutomationId="EntryPaymentProgress"
                                                     WidthRequest="96"
                                                     HorizontalOptions="End"
                                                     PaidAmount="{Binding PaidAmount}"
                                                     PlannedAmount="{Binding PlannedOrEffectiveAmount}"
                                                     FillColor="{StaticResource PartialAccent}"
                                                     OverflowColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}"
                                                     IsVisible="{Binding ShowsPaymentProgress}">
                            <controls:PaymentProgressBar.Triggers>
                                <DataTrigger TargetType="controls:PaymentProgressBar" Binding="{Binding IsPaid}" Value="True">
                                    <Setter Property="FillColor" Value="{StaticResource PaidProgressFill}" />
                                </DataTrigger>
                            </controls:PaymentProgressBar.Triggers>
                        </controls:PaymentProgressBar>
                    </VerticalStackLayout>
                </Grid>

                <!-- Entry actions menu, slides in on long press -->
                <controls:SlideOutPanel HorizontalOptions="End"
                                        BackgroundColor="#EEEEEE"
                                        Padding="6">
                    <controls:SlideOutPanel.IsOpen>
                        <MultiBinding Converter="{x:Static converters:AreEqualConverter.Instance}">
                            <Binding Path="FinancialEntryId" />
                            <Binding Path="RevealedEntryId"
                                     Source="{RelativeSource AncestorType={x:Type vm:MonthViewModel}}"
                                     x:DataType="vm:MonthViewModel" />
                        </MultiBinding>
                    </controls:SlideOutPanel.IsOpen>
                    <HorizontalStackLayout Spacing="6">
                        <Border AutomationId="MarkPaidEntryAction"
                                BackgroundColor="#2E7D32"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0"
                                IsVisible="{Binding IsPaid, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleStatusClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToMarkPaidLabelConverter.Instance}}"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="PartialPaymentEntryAction"
                                BackgroundColor="{StaticResource PartialAccent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0"
                                IsVisible="{Binding AllowsPartialPayment}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPartialPaymentClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToMarkPartialPaidLabelConverter.Instance}}"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="MarkPendingEntryAction"
                                BackgroundColor="#757575"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0"
                                IsVisible="{Binding IsPaid}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleStatusClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Pendente"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="DeleteEntryAction"
                                BackgroundColor="#D32F2F"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteEntryClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Excluir"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </controls:SlideOutPanel>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <!-- Programmatic jumps (month picker, "Mês atual") would otherwise animate through every month in between -->
        <CarouselView ItemsSource="{Binding Months}"
                      Position="{Binding CurrentPosition, Mode=TwoWay}"
                      IsScrollAnimated="False"
                      Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthViewModel">
                    <ScrollView x:Name="monthScroll">
                        <VerticalStackLayout Padding="20"
                                             Spacing="15"
                                             MinimumHeightRequest="{Binding Height, Source={x:Reference monthScroll}, x:DataType=ScrollView}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <!-- Month header: arrows step one month, the title pill opens the month/year picker -->
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="44, *, 44" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            AutomationId="PreviousMonthButton"
                                            Text="‹"
                                            Style="{StaticResource MonthArrowButton}"
                                            Command="{Binding GoToPreviousMonthCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" />

                                    <Border Grid.Column="1"
                                            AutomationId="MonthTitleButton"
                                            HorizontalOptions="Center"
                                            BackgroundColor="{StaticResource MonthNavTint}"
                                            Stroke="{StaticResource MonthNavAccent}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 24"
                                            Padding="14,8,8,8"
                                            MinimumHeightRequest="44">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
                                        </Border.GestureRecognizers>
                                        <!-- The badge has its own column so a long month name truncates instead of pushing it out of the pill -->
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Label AutomationId="MonthTitleLabel"
                                                   Text="{Binding MonthName}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   TextColor="{StaticResource MonthNavAccent}"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1"
                                                    AutomationId="MonthPickerBadge"
                                                    BackgroundColor="{StaticResource MonthNavAccent}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    WidthRequest="24"
                                                    HeightRequest="24"
                                                    VerticalOptions="Center">
                                                <Label Text="▾"
                                                       FontSize="16"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="2"
                                            AutomationId="NextMonthButton"
                                            Text="›"
                                            Style="{StaticResource MonthArrowButton}"
                                            Command="{Binding GoToNextMonthCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" />
                                </Grid>

                                <Label AutomationId="SwipeHintLabel"
                                       Text="Toque no mês para escolher ou deslize para os lados"
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding ShowSwipeHint, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" />
                            </VerticalStackLayout>

                            <!-- Summary Bar: swipe sideways (or tap the dots) for the paid and received totals -->
                            <Frame AutomationId="SummaryBar" BackgroundColor="#F0F0F0" CornerRadius="10" Padding="15,12,15,4">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                                </Frame.GestureRecognizers>
                                <controls:SwipePager SelectedIndex="{Binding SummaryPage}" IndicatorColor="{StaticResource MonthNavAccent}">
                                    <!-- The pager handles its own touches, so it needs its own "tap outside" too -->
                                    <controls:SwipePager.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                                    </controls:SwipePager.GestureRecognizers>
                                    <Grid AutomationId="SummaryTotalsPage" ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                            <Label Text="Receitas" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryIncomeLabel" Text="{Binding TotalIncomes, Converter={x:Static converters:MoneyConverter.Instance}}" TextColor="Green" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                            <Label Text="Despesas" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryOutcomeLabel" Text="{Binding TotalOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}" TextColor="Red" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                            <Label Text="Balanço" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryBalanceLabel" Text="{Binding Balance, Converter={x:Static converters:MoneyConverter.Instance}}" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <HorizontalStackLayout AutomationId="SummaryPaidPage" HorizontalOptions="Center" Spacing="40">
                                        <VerticalStackLayout>
                                            <Label Text="Pago" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryPaidLabel" Text="{Binding PaidOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}" TextColor="{StaticResource PaidAccent}" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout>
                                            <Label Text="A pagar" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryToPayLabel" Text="{Binding PendingOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}" TextColor="{StaticResource OutcomeAccent}" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout AutomationId="SummaryReceivedPage" HorizontalOptions="Center" Spacing="40">
                                        <VerticalStackLayout>
                                            <Label Text="Recebido" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryReceivedLabel" Text="{Binding ReceivedIncomes, Converter={x:Static converters:MoneyConverter.Instance}}" TextColor="{StaticResource IncomeAccent}" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout>
                                            <Label Text="A receber" FontSize="12" TextColor="Gray"/>
                                            <Label AutomationId="SummaryToReceiveLabel" Text="{Binding PendingIncomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </controls:SwipePager>
                            </Frame>

                            <!-- Outcomes Section -->
                            <Border Stroke="{StaticResource OutcomeAccent}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White"
                                    Padding="0"
                                    Margin="0,10,0,0">
                                <VerticalStackLayout>
                                    <Grid AutomationId="OutcomesHeader"
                                          ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12"
                                          Padding="0,0,12,0"
                                          BackgroundColor="{StaticResource OutcomeTint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleOutcomesCommand}" />
                                        </Grid.GestureRecognizers>
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="5"
                                                 Color="{StaticResource OutcomeAccent}" />
                                        <VerticalStackLayout Grid.Column="1" Padding="0,10">
                                            <Label Text="Despesas"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   TextColor="{StaticResource OutcomeAccent}"/>
                                            <Label AutomationId="OutcomeCountLabel"
                                                   Text="{Binding OutcomeCount, StringFormat='{0} lançamento(s)'}"
                                                   TextColor="Gray"
                                                   FontSize="11"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="OutcomeTotalLabel"
                                               Text="{Binding TotalOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               TextColor="{StaticResource OutcomeAccent}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                        <controls:ExpandChevron Grid.Column="3"
                                                                IsExpanded="{Binding IsOutcomesExpanded}"
                                                                AccentColor="{StaticResource OutcomeAccent}" />
                                    </Grid>

                                    <CollectionView ItemsSource="{Binding OutcomeEntries}"
                                                    ItemTemplate="{StaticResource EntryRowTemplate}"
                                                    IsVisible="{Binding IsOutcomesExpanded}"
                                                    SelectionMode="None" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Incomes Section -->
                            <Border Stroke="{StaticResource IncomeAccent}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White"
                                    Padding="0"
                                    Margin="0,10,0,0">
                                <VerticalStackLayout>
                                    <Grid AutomationId="IncomesHeader"
                                          ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12"
                                          Padding="0,0,12,0"
                                          BackgroundColor="{StaticResource IncomeTint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleIncomesCommand}" />
                                        </Grid.GestureRecognizers>
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="5"
                                                 Color="{StaticResource IncomeAccent}" />
                                        <VerticalStackLayout Grid.Column="1" Padding="0,10">
                                            <Label Text="Receitas"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   TextColor="{StaticResource IncomeAccent}"/>
                                            <Label AutomationId="IncomeCountLabel"
                                                   Text="{Binding IncomeCount, StringFormat='{0} lançamento(s)'}"
                                                   TextColor="Gray"
                                                   FontSize="11"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="IncomeTotalLabel"
                                               Text="{Binding TotalIncomes, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               TextColor="{StaticResource IncomeAccent}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                        <controls:ExpandChevron Grid.Column="3"
                                                                IsExpanded="{Binding IsIncomesExpanded}"
                                                                AccentColor="{StaticResource IncomeAccent}" />
                                    </Grid>

                                    <CollectionView ItemsSource="{Binding IncomeEntries}"
                                                    ItemTemplate="{StaticResource EntryRowTemplate}"
                                                    IsVisible="{Binding IsIncomesExpanded}"
                                                    SelectionMode="None" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bottom padding so FAB doesn't overlap last item -->
                            <ContentView HeightRequest="80" />

                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <Button Text="Nuke DB"
                Command="{Binding ClearDatabaseCommand}"
                FontSize="10"
                HeightRequest="30"
                WidthRequest="70"
                BackgroundColor="#33FF0000"
                TextColor="Red"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="20,0,0,33" />
        <Button AutomationId="GoToCurrentMonthButton"
                Text="{Binding GoToCurrentMonthLabel}"
                Command="{Binding GoToCurrentMonthCommand}"
                IsVisible="{Binding IsAwayFromCurrentMonth}"
                FontSize="13"
                HeightRequest="40"
                Padding="16,0"
                CornerRadius="20"
                BackgroundColor="#EDE7F6"
                TextColor="Purple"
                BorderColor="Purple"
                BorderWidth="1"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,28" />
        <Button AutomationId="AddEntryButton"
                Text="+"
                FontSize="24"
                BackgroundColor="Purple"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
