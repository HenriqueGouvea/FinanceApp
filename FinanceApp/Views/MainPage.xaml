<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             x:Class="FinanceApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">
    <Grid>
        <CarouselView ItemsSource="{Binding Months}"
                      Position="{Binding CurrentPosition, Mode=TwoWay}"
                      Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthViewModel">
                    <ScrollView>
                        <VerticalStackLayout Padding="20" Spacing="15">

                            <!-- Month Title -->
                            <Label Text="{Binding MonthName}"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold" />

                            <!-- Summary Bar -->
                            <Frame BackgroundColor="#F0F0F0" CornerRadius="10" Padding="15">
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="30">
                                    <VerticalStackLayout>
                                        <Label Text="Receitas" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding TotalIncomes, StringFormat='R$ {0:F2}'}" TextColor="Green" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Text="Despesas" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding TotalOutcomes, StringFormat='R$ {0:F2}'}" TextColor="Red" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Text="Balanço" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding Balance, StringFormat='R$ {0:F2}'}" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- Outcomes Section Header -->
                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,5">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleOutcomesCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Despesas" FontAttributes="Bold" FontSize="16" TextColor="Red"/>
                                    <Label TextColor="Gray" FontSize="11">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} lançamento(s) · R$ {1:F2}">
                                                <Binding Path="OutcomeCount" />
                                                <Binding Path="TotalOutcomes" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="▼"
                                       FontSize="14"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsOutcomesExpanded}" />
                                <Label Grid.Column="2"
                                       Text="▶"
                                       FontSize="14"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsOutcomesExpanded, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="Red" Opacity="0.3" />

                            <!-- Outcomes List -->
                            <CollectionView ItemsSource="{Binding OutcomeEntries}"
                                            IsVisible="{Binding IsOutcomesExpanded}"
                                            SelectionMode="Single"
                                            SelectionChanged="OnEntrySelectionChanged">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MonthlyEntryProjection">
                                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="10">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Description}" FontAttributes="Bold"/>
                                                <Label Text="{Binding InstallmentLabel}"
                                                       FontSize="11"
                                                       TextColor="Gray"
                                                       IsVisible="{Binding InstallmentLabel, Converter={x:Static converters:IsNotNullConverter.Instance}}"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontSize="11"
                                                   TextColor="Gray"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,8,0"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding EffectiveAmount, StringFormat='R$ {0:F2}'}"
                                                   TextColor="Red"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Incomes Section Header -->
                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,5" Margin="0,10,0,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleIncomesCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Receitas" FontAttributes="Bold" FontSize="16" TextColor="Green"/>
                                    <Label TextColor="Gray" FontSize="11">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} lançamento(s) · R$ {1:F2}">
                                                <Binding Path="IncomeCount" />
                                                <Binding Path="TotalIncomes" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="▼"
                                       FontSize="14"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsIncomesExpanded}" />
                                <Label Grid.Column="2"
                                       Text="▶"
                                       FontSize="14"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsIncomesExpanded, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="Green" Opacity="0.3" />

                            <!-- Incomes List -->
                            <CollectionView ItemsSource="{Binding IncomeEntries}"
                                            IsVisible="{Binding IsIncomesExpanded}"
                                            SelectionMode="Single"
                                            SelectionChanged="OnEntrySelectionChanged">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MonthlyEntryProjection">
                                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="10">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Description}" FontAttributes="Bold"/>
                                                <Label Text="{Binding InstallmentLabel}"
                                                       FontSize="11"
                                                       TextColor="Gray"
                                                       IsVisible="{Binding InstallmentLabel, Converter={x:Static converters:IsNotNullConverter.Instance}}"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontSize="11"
                                                   TextColor="Gray"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,8,0"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding EffectiveAmount, StringFormat='R$ {0:F2}'}"
                                                   TextColor="Green"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Bottom padding so FAB doesn't overlap last item -->
                            <BoxView HeightRequest="80" IsVisible="False" />

                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <Button Text="Nuke DB"
                Command="{Binding ClearDatabaseCommand}"
                FontSize="10"
                HeightRequest="30"
                WidthRequest="70"
                BackgroundColor="#33FF0000"
                TextColor="Red"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="10" />
        <Button Text="+"
                FontSize="24"
                BackgroundColor="Purple"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
