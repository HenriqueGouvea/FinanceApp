<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Models"
             xmlns:converters="clr-namespace:FinanceApp.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:FinanceApp.Controls"
             x:Class="FinanceApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Início">
    <ContentPage.Resources>
        <!-- Month arrows on the plum header: light chevrons beside the month pill, with a 44dp touch area -->
        <Style x:Key="MonthArrowButton" TargetType="Button">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource White}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.25" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small grey detail under an entry's description ("Moradia · Vence 15/11 · 🏦 Conta") -->
        <Style x:Key="EntryMeta" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <!-- Action of the long-press menu -->
        <Style x:Key="EntryAction" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <DataTemplate x:Key="EntryRowTemplate" x:DataType="models:MonthlyEntryProjection">
            <Grid IsClippedToBounds="True" BackgroundColor="{StaticResource CardBackground}">
                <Grid.Triggers>
                    <MultiTrigger TargetType="Grid">
                        <MultiTrigger.Conditions>
                            <BindingCondition Binding="{Binding IsAlternateRow}" Value="True" />
                            <BindingCondition Binding="{Binding EntryType}" Value="{x:Static models:FinancialEntryType.Outcome}" />
                        </MultiTrigger.Conditions>
                        <Setter Property="BackgroundColor" Value="{StaticResource OutcomeAlternateRow}" />
                    </MultiTrigger>
                    <MultiTrigger TargetType="Grid">
                        <MultiTrigger.Conditions>
                            <BindingCondition Binding="{Binding IsAlternateRow}" Value="True" />
                            <BindingCondition Binding="{Binding EntryType}" Value="{x:Static models:FinancialEntryType.Income}" />
                        </MultiTrigger.Conditions>
                        <Setter Property="BackgroundColor" Value="{StaticResource IncomeAlternateRow}" />
                    </MultiTrigger>
                </Grid.Triggers>
                <BoxView HeightRequest="1" VerticalOptions="Start" Color="{StaticResource Line}" />

                <Grid AutomationId="EntryRow" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" Padding="12,9">
                    <Grid.Behaviors>
                        <toolkit:TouchBehavior LongPressDuration="1000"
                                               TouchGestureCompleted="OnEntryTapped"
                                               LongPressCompleted="OnEntryLongPressed" />
                    </Grid.Behaviors>

                    <!-- Status: grey ring while pending, orange ring when partially paid, green check once paid/received -->
                    <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                        <Border AutomationId="EntryPendingIcon"
                                StrokeShape="RoundRectangle 11"
                                Stroke="{StaticResource MutedBrush}"
                                StrokeThickness="2"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsPending}" />
                        <Border AutomationId="EntryPartialIcon"
                                StrokeShape="RoundRectangle 11"
                                Stroke="{StaticResource PartialBrush}"
                                StrokeThickness="3"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsPartiallyPaid}" />
                        <Border AutomationId="EntryPaidIcon"
                                StrokeShape="RoundRectangle 11"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Paid}"
                                IsVisible="{Binding IsPaid}">
                            <Label Text="✓"
                                   TextColor="White"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <!-- Description, with the "±" (estimated) and installment ("3/10") badges -->
                        <HorizontalStackLayout Spacing="5" IsClippedToBounds="True">
                            <Label AutomationId="EntryDescriptionLabel"
                                   Text="{Binding Description}"
                                   FontSize="14"
                                   FontFamily="OpenSansSemibold"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Border AutomationId="EntryEstimatedIcon" Style="{StaticResource Badge}" IsVisible="{Binding IsEstimated}">
                                <Label Text="±" Style="{StaticResource BadgeLabel}" />
                            </Border>
                            <Border Style="{StaticResource Badge}"
                                    IsVisible="{Binding InstallmentLabel, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                                <Label AutomationId="EntryInstallmentLabel" Text="{Binding InstallmentLabel}" Style="{StaticResource BadgeLabel}" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- One line of details; each part after the category brings its own " · " -->
                        <HorizontalStackLayout IsClippedToBounds="True">
                            <Label AutomationId="EntryCategoryLabel"
                                   Text="{Binding Category.Name}"
                                   Style="{StaticResource EntryMeta}"
                                   IsVisible="{Binding Category, Converter={x:Static converters:IsNotNullConverter.Instance}}" />
                            <Label Text="Sem categoria"
                                   Style="{StaticResource EntryMeta}"
                                   IsVisible="{Binding Category, Converter={x:Static converters:IsNullConverter.Instance}}" />
                            <HorizontalStackLayout IsVisible="{Binding IsPaid}">
                                <Label Text=" · " Style="{StaticResource EntryMeta}" />
                                <Label AutomationId="EntryStatusLabel"
                                       Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToPaidLabelConverter.Instance}}"
                                       Style="{StaticResource EntryMeta}"
                                       TextColor="{StaticResource Paid}"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <!-- Turns red while it is due today and not yet paid/received -->
                            <HorizontalStackLayout IsVisible="{Binding ShowsDueDateInRow}">
                                <Label Text=" · " Style="{StaticResource EntryMeta}" />
                                <Label AutomationId="EntryDueDateLabel"
                                       Text="{Binding DueDate, Converter={x:Static converters:DueDateToLabelConverter.Instance}}"
                                       Style="{StaticResource EntryMeta}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDueToday}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Outcome}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout IsVisible="{Binding InstallmentTotalAmount, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                                <Label Text=" · " Style="{StaticResource EntryMeta}" />
                                <Label AutomationId="EntryInstallmentTotalLabel"
                                       Text="{Binding InstallmentTotalAmount, Converter={x:Static converters:MoneyConverter.Instance}, StringFormat='total {0}'}"
                                       Style="{StaticResource EntryMeta}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout IsVisible="{Binding ShowsPaymentSourceInRow}">
                                <Label Style="{StaticResource EntryMeta}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text=" · " />
                                            <Span Text="{Binding PaymentSource.Type, Converter={x:Static converters:PaymentSourceTypeToIconConverter.Instance}}" />
                                            <Span Text=" " />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label AutomationId="EntryPaymentSourceLabel"
                                       Text="{Binding PaymentSource.Name}"
                                       Style="{StaticResource EntryMeta}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Everything about the amount stays on the right: the amount, then the payment progress under it -->
                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                        <Label AutomationId="EntryAmountLabel"
                               Text="{Binding ShownAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="End" />
                        <controls:PaymentProgressBar AutomationId="EntryPaymentProgress"
                                                     WidthRequest="78"
                                                     HorizontalOptions="End"
                                                     PaidAmount="{Binding PaidAmount}"
                                                     PlannedAmount="{Binding PlannedOrEffectiveAmount}"
                                                     FillColor="{StaticResource Partial}"
                                                     OverflowColor="{StaticResource Outcome}"
                                                     IsVisible="{Binding ShowsPaymentProgress}">
                            <controls:PaymentProgressBar.Triggers>
                                <DataTrigger TargetType="controls:PaymentProgressBar" Binding="{Binding IsPaid}" Value="True">
                                    <Setter Property="FillColor" Value="{StaticResource PaidProgressFill}" />
                                </DataTrigger>
                                <DataTrigger TargetType="controls:PaymentProgressBar" Binding="{Binding EntryType}" Value="{x:Static models:FinancialEntryType.Income}">
                                    <Setter Property="OverflowColor" Value="{StaticResource Income}" />
                                </DataTrigger>
                            </controls:PaymentProgressBar.Triggers>
                        </controls:PaymentProgressBar>
                        <!-- Partially paid within the plan: the amount above is what was paid so far -->
                        <Label AutomationId="EntryPartialLabel"
                               Text="{Binding EffectiveAmount, Converter={x:Static converters:MoneyConverter.Instance}, StringFormat='de {0}'}"
                               FontSize="10"
                               TextColor="{StaticResource Muted}"
                               HorizontalOptions="End"
                               IsVisible="{Binding ShowsPaidSoFar}" />
                        <!-- Paid beyond the planned amount (e.g. a supermarket above its estimate): the amount above is what was paid -->
                        <Label AutomationId="EntryPlannedAmountLabel"
                               FontSize="10"
                               HorizontalOptions="End"
                               IsVisible="{Binding IsOverBudget}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="▲ "
                                          FontAttributes="Bold"
                                          TextColor="{Binding EntryType, Converter={x:Static converters:EntryTypeToColorConverter.Instance}}" />
                                    <Span Text="{Binding PlannedOrEffectiveAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                          TextColor="{StaticResource Muted}"
                                          TextDecorations="Strikethrough" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <!-- Entry actions menu, slides in on long press -->
                <controls:SlideOutPanel HorizontalOptions="End"
                                        BackgroundColor="{StaticResource Line}"
                                        Padding="6">
                    <controls:SlideOutPanel.IsOpen>
                        <MultiBinding Converter="{x:Static converters:AreEqualConverter.Instance}">
                            <Binding Path="FinancialEntryId" />
                            <Binding Path="RevealedEntryId"
                                     Source="{RelativeSource AncestorType={x:Type vm:MonthViewModel}}"
                                     x:DataType="vm:MonthViewModel" />
                        </MultiBinding>
                    </controls:SlideOutPanel.IsOpen>
                    <HorizontalStackLayout Spacing="6">
                        <Border AutomationId="MarkPaidEntryAction"
                                Style="{StaticResource EntryAction}"
                                BackgroundColor="{StaticResource Paid}"
                                IsVisible="{Binding IsPaid, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleStatusClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToMarkPaidLabelConverter.Instance}}"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="PartialPaymentEntryAction"
                                Style="{StaticResource EntryAction}"
                                BackgroundColor="{StaticResource Partial}"
                                IsVisible="{Binding AllowsPartialPayment}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPartialPaymentClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding EntryType, Converter={x:Static converters:EntryTypeToMarkPartialPaidLabelConverter.Instance}}"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="MarkPendingEntryAction"
                                Style="{StaticResource EntryAction}"
                                BackgroundColor="{StaticResource Muted}"
                                IsVisible="{Binding IsPaid}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleStatusClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Pendente"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border AutomationId="DeleteEntryAction"
                                Style="{StaticResource EntryAction}"
                                BackgroundColor="{StaticResource Outcome}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteEntryClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="Excluir"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </controls:SlideOutPanel>
            </Grid>
        </DataTemplate>

        <!-- A credit card's bill: a lilac row marked on the left, with the card's outcomes listed under it -->
        <DataTemplate x:Key="CreditCardBillTemplate" x:DataType="models:CreditCardBill">
            <VerticalStackLayout AutomationId="CreditCardBill">
                <Grid IsClippedToBounds="True" BackgroundColor="{StaticResource BillTint}">
                    <BoxView HeightRequest="1" VerticalOptions="Start" Color="{StaticResource Line}" />
                    <BoxView WidthRequest="4" HorizontalOptions="Start" Color="{StaticResource BillAccent}" />
                    <Grid AutomationId="CreditCardBillRow" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" Padding="12,9">
                        <Grid.Behaviors>
                            <toolkit:TouchBehavior LongPressDuration="1000"
                                                   TouchGestureCompleted="OnBillTapped"
                                                   LongPressCompleted="OnBillLongPressed" />
                        </Grid.Behaviors>

                        <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                            <Border AutomationId="CreditCardBillPendingIcon"
                                    StrokeShape="RoundRectangle 11"
                                    Stroke="{StaticResource MutedBrush}"
                                    StrokeThickness="2"
                                    BackgroundColor="Transparent"
                                    IsVisible="{Binding IsPending}" />
                            <Border AutomationId="CreditCardBillPartialIcon"
                                    StrokeShape="RoundRectangle 11"
                                    Stroke="{StaticResource PartialBrush}"
                                    StrokeThickness="3"
                                    BackgroundColor="Transparent"
                                    IsVisible="{Binding IsPartiallyPaid}" />
                            <Border AutomationId="CreditCardBillPaidIcon"
                                    StrokeShape="RoundRectangle 11"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource Paid}"
                                    IsVisible="{Binding IsPaid}">
                                <Label Text="✓"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label AutomationId="CreditCardBillNameLabel"
                                   Text="{Binding Card.Name, StringFormat='💳 Fatura {0}'}"
                                   FontSize="14"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Primary}"
                                   LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout IsClippedToBounds="True">
                                <!-- Turns red while it is due today and not yet paid -->
                                <Label AutomationId="CreditCardBillDueDateLabel"
                                       Text="{Binding DueDate, Converter={x:Static converters:DueDateToLabelConverter.Instance}}"
                                       Style="{StaticResource EntryMeta}"
                                       IsVisible="{Binding HasDueDate}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDueToday}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Outcome}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text=" · " Style="{StaticResource EntryMeta}" IsVisible="{Binding HasDueDate}" />
                                <HorizontalStackLayout IsVisible="{Binding HasPaymentAccount}">
                                    <Label AutomationId="CreditCardBillAccountLabel"
                                           Text="{Binding PaymentAccount.Name, StringFormat='Débito em {0}'}"
                                           Style="{StaticResource EntryMeta}" />
                                    <Label Text=" · " Style="{StaticResource EntryMeta}" />
                                </HorizontalStackLayout>
                                <Label AutomationId="CreditCardBillCountLabel"
                                       Text="{Binding EntryCount, StringFormat='{0} lançamento(s)'}"
                                       Style="{StaticResource EntryMeta}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                            <Label AutomationId="CreditCardBillAmountLabel"
                                   Text="{Binding TotalAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End" />
                            <Label AutomationId="CreditCardBillStatusLabel"
                                   Text="Paga"
                                   TextColor="{StaticResource Paid}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End"
                                   IsVisible="{Binding IsPaid}" />
                            <Label AutomationId="CreditCardBillPaidLabel"
                                   Text="{Binding PaidAmount, Converter={x:Static converters:MoneyConverter.Instance}}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Partial}"
                                   HorizontalOptions="End"
                                   IsVisible="{Binding IsPartiallyPaid}" />
                        </VerticalStackLayout>
                        <!-- Tapping the bill shows or hides its entries -->
                        <Label Grid.Column="3"
                               Text="▾"
                               FontSize="13"
                               TextColor="{StaticResource BillAccent}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Text" Value="▸" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <!-- Bill actions menu, slides in on long press -->
                    <controls:SlideOutPanel HorizontalOptions="End"
                                            BackgroundColor="{StaticResource Line}"
                                            Padding="6">
                        <controls:SlideOutPanel.IsOpen>
                            <MultiBinding Converter="{x:Static converters:AreEqualConverter.Instance}">
                                <Binding Path="Card.Id" />
                                <Binding Path="RevealedBillCardId"
                                         Source="{RelativeSource AncestorType={x:Type vm:MonthViewModel}}"
                                         x:DataType="vm:MonthViewModel" />
                            </MultiBinding>
                        </controls:SlideOutPanel.IsOpen>
                        <HorizontalStackLayout Spacing="6">
                            <Border AutomationId="PayCreditCardBillAction"
                                    Style="{StaticResource EntryAction}"
                                    BackgroundColor="{StaticResource Paid}"
                                    IsVisible="{Binding IsPaid, Converter={x:Static converters:InverseBoolConverter.Instance}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleBillStatusClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="Pagar fatura"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                            </Border>
                            <Border AutomationId="MarkCreditCardBillPendingAction"
                                    Style="{StaticResource EntryAction}"
                                    BackgroundColor="{StaticResource Muted}"
                                    IsVisible="{Binding IsPaid}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleBillStatusClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="Pendente"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </controls:SlideOutPanel>
                </Grid>

                <!-- Indented under the bill, so the entries read as part of it -->
                <VerticalStackLayout AutomationId="CreditCardBillEntries"
                                     Padding="22,0,0,0"
                                     BackgroundColor="{StaticResource CardBackground}"
                                     IsVisible="{Binding IsExpanded}"
                                     BindableLayout.ItemsSource="{Binding Entries}"
                                     BindableLayout.ItemTemplate="{StaticResource EntryRowTemplate}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Top bar: the app name (or, once the month header has scrolled away, the month) and the user's avatar -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto" Padding="0,0,14,0">
            <Label AutomationId="AppBrandLabel"
                   Grid.ColumnSpan="2"
                   Text="Mensal"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TranslationX="-22"
                   IsVisible="{Binding IsHeaderCompact, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
            <Border AutomationId="CompactMonthButton"
                    Grid.ColumnSpan="2"
                    BackgroundColor="{StaticResource HeaderPill}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 17"
                    Padding="14,5"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TranslationX="-22"
                    IsVisible="{Binding IsHeaderCompact}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label AutomationId="CompactMonthTitleLabel"
                           Text="{Binding SelectedMonth.MonthName}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Label Text="▾" FontSize="13" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <!-- The user's initial or photo; opens the settings -->
            <Border x:Name="HeaderAvatar"
                    Grid.Column="1"
                    x:DataType="vm:UserProfileViewModel"
                    AutomationId="HeaderAvatar"
                    WidthRequest="32"
                    HeightRequest="32"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Accent}"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAvatarTapped" />
                </Border.GestureRecognizers>
                <Grid>
                    <Label AutomationId="HeaderAvatarInitialLabel"
                           Text="{Binding Initial}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasPhoto, Converter={x:Static converters:InverseBoolConverter.Instance}}" />
                    <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}" />
                </Grid>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <!-- Programmatic jumps (month picker, "Mês atual") would otherwise animate through every month in between -->
        <CarouselView ItemsSource="{Binding Months}"
                      Position="{Binding CurrentPosition, Mode=TwoWay}"
                      IsScrollAnimated="False"
                      Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthViewModel">
                    <ScrollView x:Name="monthScroll" Scrolled="OnMonthScrolled">
                        <VerticalStackLayout MinimumHeightRequest="{Binding Height, Source={x:Reference monthScroll}, x:DataType=ScrollView}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <!-- Plum header, continuing the top bar: the month, with the summary card overlapping its lower edge -->
                            <Grid RowDefinitions="Auto, 26, Auto">
                                <BoxView Grid.RowSpan="2" Color="{StaticResource Primary}" />

                                <!-- Arrows step one month, the pill opens the month/year picker -->
                                <VerticalStackLayout Grid.Row="0" Padding="16,2,16,6" Spacing="2">
                                    <Grid ColumnDefinitions="44, Auto, 44" ColumnSpacing="6" HorizontalOptions="Center">
                                        <Button Grid.Column="0"
                                                AutomationId="PreviousMonthButton"
                                                Text="‹"
                                                Style="{StaticResource MonthArrowButton}"
                                                Command="{Binding GoToPreviousMonthCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" />

                                        <Border Grid.Column="1"
                                                AutomationId="MonthTitleButton"
                                                BackgroundColor="{StaticResource HeaderPill}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 22"
                                                Padding="18,8,14,8"
                                                MinimumHeightRequest="44">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
                                            </Border.GestureRecognizers>
                                            <!-- The badge has its own column so a long month name truncates instead of pushing it out of the pill -->
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                                <Label AutomationId="MonthTitleLabel"
                                                       Text="{Binding MonthName}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"
                                                       TextColor="White"
                                                       VerticalOptions="Center" />
                                                <Grid Grid.Column="1"
                                                      AutomationId="MonthPickerBadge"
                                                      WidthRequest="18"
                                                      HeightRequest="18"
                                                      VerticalOptions="Center">
                                                    <Label Text="▾"
                                                           FontSize="14"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Button Grid.Column="2"
                                                AutomationId="NextMonthButton"
                                                Text="›"
                                                Style="{StaticResource MonthArrowButton}"
                                                Command="{Binding GoToNextMonthCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" />
                                    </Grid>

                                    <Label AutomationId="SwipeHintLabel"
                                           Text="Toque no mês para escolher ou deslize para os lados"
                                           FontSize="12"
                                           TextColor="{StaticResource BillAccent}"
                                           HorizontalTextAlignment="Center"
                                           IsVisible="{Binding ShowSwipeHint, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" />
                                </VerticalStackLayout>

                                <!-- Summary: swipe sideways (or tap the dots) for the paid and received totals -->
                                <Border Grid.Row="1"
                                        Grid.RowSpan="2"
                                        AutomationId="SummaryBar"
                                        Style="{StaticResource Card}"
                                        Margin="14,0"
                                        Padding="15,12,15,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                                    </Border.GestureRecognizers>
                                    <controls:SwipePager SelectedIndex="{Binding SummaryPage}" IndicatorColor="{StaticResource Primary}">
                                        <!-- The pager handles its own touches, so it needs its own "tap outside" too -->
                                        <controls:SwipePager.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding HideEntryActionsCommand}" />
                                        </controls:SwipePager.GestureRecognizers>
                                        <Grid AutomationId="SummaryTotalsPage" ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Receitas" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryIncomeLabel" Text="{Binding TotalIncomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" TextColor="{StaticResource Income}" FontAttributes="Bold" LineBreakMode="NoWrap" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="Despesas" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryOutcomeLabel" Text="{Binding TotalOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" TextColor="{StaticResource Outcome}" FontAttributes="Bold" LineBreakMode="NoWrap" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2">
                                                <Label Text="Balanço" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryBalanceLabel" Text="{Binding Balance, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" FontAttributes="Bold" LineBreakMode="NoWrap" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid AutomationId="SummaryPaidPage" ColumnDefinitions="*, *" ColumnSpacing="6">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Pago" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryPaidLabel" Text="{Binding PaidOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" TextColor="{StaticResource Paid}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="A pagar" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryToPayLabel" Text="{Binding PendingOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" TextColor="{StaticResource Outcome}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid AutomationId="SummaryReceivedPage" ColumnDefinitions="*, *" ColumnSpacing="6">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Recebido" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryReceivedLabel" Text="{Binding ReceivedIncomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" TextColor="{StaticResource Income}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="A receber" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label AutomationId="SummaryToReceiveLabel" Text="{Binding PendingIncomes, Converter={x:Static converters:MoneyConverter.Instance}}" FontSize="14" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </controls:SwipePager>
                                </Border>
                            </Grid>

                            <!-- Outcomes -->
                            <Border Style="{StaticResource Card}" Margin="12,14,12,0">
                                <VerticalStackLayout>
                                    <Grid AutomationId="OutcomesHeader"
                                          ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="8"
                                          Padding="14,11"
                                          BackgroundColor="{StaticResource OutcomeTint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleOutcomesCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="▾" FontSize="12" TextColor="{StaticResource Outcome}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOutcomesExpanded}" Value="False">
                                                    <Setter Property="Text" Value="▸" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="Despesas" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Outcome}" VerticalOptions="Center" />
                                            <Label Text=" · " FontSize="11" TextColor="{StaticResource Outcome}" Opacity="0.75" VerticalOptions="Center" />
                                            <Label AutomationId="OutcomeCountLabel"
                                                   Text="{Binding OutcomeCount, StringFormat='{0} lançamento(s)'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Outcome}"
                                                   Opacity="0.75"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="OutcomeTotalLabel"
                                               Text="{Binding TotalOutcomes, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               TextColor="{StaticResource Outcome}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout IsVisible="{Binding IsOutcomesExpanded}">
                                        <CollectionView ItemsSource="{Binding OutcomeEntries}"
                                                        ItemTemplate="{StaticResource EntryRowTemplate}"
                                                        SelectionMode="None" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CreditCardBills}"
                                                             BindableLayout.ItemTemplate="{StaticResource CreditCardBillTemplate}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Incomes -->
                            <Border Style="{StaticResource Card}" Margin="12,12,12,0">
                                <VerticalStackLayout>
                                    <Grid AutomationId="IncomesHeader"
                                          ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="8"
                                          Padding="14,11"
                                          BackgroundColor="{StaticResource IncomeTint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleIncomesCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="▾" FontSize="12" TextColor="{StaticResource Income}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsIncomesExpanded}" Value="False">
                                                    <Setter Property="Text" Value="▸" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="Receitas" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Income}" VerticalOptions="Center" />
                                            <Label Text=" · " FontSize="11" TextColor="{StaticResource Income}" Opacity="0.75" VerticalOptions="Center" />
                                            <Label AutomationId="IncomeCountLabel"
                                                   Text="{Binding IncomeCount, StringFormat='{0} lançamento(s)'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Income}"
                                                   Opacity="0.75"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="2"
                                               AutomationId="IncomeTotalLabel"
                                               Text="{Binding TotalIncomes, Converter={x:Static converters:MoneyConverter.Instance}}"
                                               TextColor="{StaticResource Income}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <CollectionView ItemsSource="{Binding IncomeEntries}"
                                                    ItemTemplate="{StaticResource EntryRowTemplate}"
                                                    IsVisible="{Binding IsIncomesExpanded}"
                                                    SelectionMode="None" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- A collapsed section only shows its header, so this tells how to bring its entries back -->
                            <Border AutomationId="CollapsedSectionsHint"
                                    Style="{StaticResource Card}"
                                    Margin="12,14,12,0"
                                    Padding="14,12"
                                    IsVisible="{Binding CollapsedSectionsHint, Converter={x:Static converters:IsNotNullConverter.Instance}}">
                                <Label AutomationId="CollapsedSectionsHintLabel"
                                       Text="{Binding CollapsedSectionsHint}"
                                       FontSize="12"
                                       TextColor="{StaticResource Muted}" />
                            </Border>

                            <!-- Bottom padding so the "+" button doesn't cover the last row -->
                            <ContentView HeightRequest="96" />

                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <Button Text="Nuke DB"
                Command="{Binding ClearDatabaseCommand}"
                FontSize="10"
                HeightRequest="30"
                WidthRequest="70"
                Padding="0"
                BackgroundColor="#33FF0000"
                TextColor="Red"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="20,0,0,33" />
        <Button AutomationId="GoToCurrentMonthButton"
                Text="{Binding GoToCurrentMonthLabel}"
                Command="{Binding GoToCurrentMonthCommand}"
                IsVisible="{Binding IsAwayFromCurrentMonth}"
                FontSize="13"
                HeightRequest="40"
                Padding="16,0"
                CornerRadius="20"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,28">
            <Button.Shadow>
                <Shadow Radius="12" Opacity="1" Brush="#40000000" Offset="0,4" />
            </Button.Shadow>
        </Button>
        <Button AutomationId="AddEntryButton"
                Style="{StaticResource FabButton}"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
